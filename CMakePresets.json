{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },

    {
      "name": "qt-linux",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "/home/papercutter0324/Qt/6.11.1/gcc_64"
      }
    },
    {
      "name": "qt-macos",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "/Users/papercutter0324/Qt/6.11.1/macos"
      }
    },
    {
      "name": "qt-windows-desktop",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "D:/Development/Qt/6.11.1/gcc_64"
      }
    },
    {
      "name": "qt-windows-laptop",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "C:/Qt/6.11.1/msvc2022_64"
      }
    },

    {
      "name": "windows-msvc-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Visual Studio 18 2026"
    },
    {
      "name": "windows-msvc-x64-base",
      "hidden": true,
      "inherits": [
        "windows-msvc-base",
        "qt-windows-desktop"
      ],
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "windows-msvc-x64-debug",
      "displayName": "Windows MSVC x64 Debug",
      "inherits": "windows-msvc-x64-base"
    },
    {
      "name": "windows-msvc-x64-release",
      "displayName": "Windows MSVC x64 Release",
      "inherits": "windows-msvc-x64-base",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist/ClassMngr-windows-x64"
      }
    },
    {
      "name": "windows-laptop-msvc-x64-base",
      "hidden": true,
      "inherits": [
        "windows-msvc-base",
        "qt-windows-laptop"
      ],
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "windows-laptop-msvc-x64-debug",
      "displayName": "Windows Laptop MSVC x64 Debug",
      "inherits": "windows-laptop-msvc-x64-base"
    },
    {
      "name": "windows-laptop-msvc-x64-release",
      "displayName": "Windows Laptop MSVC x64 Release",
      "inherits": "windows-laptop-msvc-x64-base",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist/ClassMngr-windows-x64"
      }
    },
    {
      "name": "windows-msvc-arm64-release",
      "displayName": "Windows MSVC ARM64 Release",
      "inherits": "windows-msvc-base",
      "architecture": {
        "value": "ARM64",
        "strategy": "set"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_MSVC_ARM64_PREFIX}",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist/ClassMngr-windows-arm64"
      }
    },
    {
      "name": "windows-msvc-x86-release-optional",
      "displayName": "Windows MSVC x86 Release Optional",
      "description": "Optional best-effort target. Requires QT_MSVC_X86_PREFIX to point at a compatible 32-bit Qt MSVC installation.",
      "inherits": "windows-msvc-base",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_MSVC_X86_PREFIX}",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist/ClassMngr-windows-x86"
      }
    },

    {
      "name": "linux-gcc-debug",
      "displayName": "Linux GCC Debug",
      "inherits": [
        "base",
        "qt-linux"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux GCC Release",
      "inherits": "linux-gcc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },

    {
      "name": "macos-clang-debug",
      "displayName": "macOS Clang Debug",
      "inherits": [
        "base",
        "qt-macos"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64"
      }
    },
    {
      "name": "macos-clang-release",
      "displayName": "macOS Clang Release",
      "inherits": "macos-clang-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "windows-msvc-x64-debug",
      "configurePreset": "windows-msvc-x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-x64-release",
      "configurePreset": "windows-msvc-x64-release",
      "configuration": "Release"
    },
    {
      "name": "windows-msvc-x64-release-install",
      "configurePreset": "windows-msvc-x64-release",
      "configuration": "Release",
      "targets": [
        "INSTALL"
      ]
    },
    {
      "name": "windows-msvc-x64-release-installer",
      "displayName": "Windows MSVC x64 Release Installer",
      "configurePreset": "windows-msvc-x64-release",
      "configuration": "Release",
      "targets": [
        "ClassMngrInstaller"
      ]
    },
    {
      "name": "windows-laptop-msvc-x64-debug",
      "configurePreset": "windows-laptop-msvc-x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-laptop-msvc-x64-release",
      "configurePreset": "windows-laptop-msvc-x64-release",
      "configuration": "Release"
    },
    {
      "name": "windows-laptop-msvc-x64-release-install",
      "configurePreset": "windows-laptop-msvc-x64-release",
      "configuration": "Release",
      "targets": [
        "INSTALL"
      ]
    },
    {
      "name": "windows-laptop-msvc-x64-release-installer",
      "displayName": "Windows Laptop MSVC x64 Release Installer",
      "configurePreset": "windows-laptop-msvc-x64-release",
      "configuration": "Release",
      "targets": [
        "ClassMngrInstaller"
      ]
    },
    {
      "name": "windows-msvc-arm64-release",
      "configurePreset": "windows-msvc-arm64-release",
      "configuration": "Release"
    },
    {
      "name": "windows-msvc-arm64-release-install",
      "configurePreset": "windows-msvc-arm64-release",
      "configuration": "Release",
      "targets": [
        "INSTALL"
      ]
    },
    {
      "name": "windows-msvc-x86-release-optional",
      "configurePreset": "windows-msvc-x86-release-optional",
      "configuration": "Release"
    },
    {
      "name": "windows-msvc-x86-release-optional-install",
      "configurePreset": "windows-msvc-x86-release-optional",
      "configuration": "Release",
      "targets": [
        "INSTALL"
      ]
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug"
    },
    {
      "name": "linux-gcc-release",
      "configurePreset": "linux-gcc-release"
    },
    {
      "name": "macos-clang-debug",
      "configurePreset": "macos-clang-debug"
    },
    {
      "name": "macos-clang-release",
      "configurePreset": "macos-clang-release"
    }
  ],

  "workflowPresets": [
    {
      "name": "linux-gcc-release-artifacts",
      "displayName": "Linux GCC Release Artifacts",
      "description": "Configure and build the Linux release artifact.",
      "steps": [
        {
          "type": "configure",
          "name": "linux-gcc-release"
        },
        {
          "type": "build",
          "name": "linux-gcc-release"
        }
      ]
    },
    {
      "name": "macos-clang-universal-release-artifacts",
      "displayName": "macOS Clang Universal Release Artifacts",
      "description": "Configure and build the macOS arm64/x86_64 universal release artifact.",
      "steps": [
        {
          "type": "configure",
          "name": "macos-clang-release"
        },
        {
          "type": "build",
          "name": "macos-clang-release"
        }
      ]
    },
    {
      "name": "windows-msvc-x64-release-artifacts",
      "displayName": "Windows MSVC x64 Release Artifacts",
      "description": "Configure and build the Windows x64 release artifact.",
      "steps": [
        {
          "type": "configure",
          "name": "windows-msvc-x64-release"
        },
        {
          "type": "build",
          "name": "windows-msvc-x64-release"
        },
        {
          "type": "build",
          "name": "windows-msvc-x64-release-install"
        }
      ]
    },
    {
      "name": "windows-msvc-x64-release-installer-artifacts",
      "displayName": "Windows MSVC x64 Release Installer Artifacts",
      "description": "Configure, build, install, and package the Windows x64 release installer.",
      "steps": [
        {
          "type": "configure",
          "name": "windows-msvc-x64-release"
        },
        {
          "type": "build",
          "name": "windows-msvc-x64-release-installer"
        }
      ]
    },
    {
      "name": "windows-laptop-msvc-x64-release-artifacts",
      "displayName": "Windows Laptop MSVC x64 Release Artifacts",
      "description": "Configure, build, and install the Windows laptop x64 release artifact.",
      "steps": [
        {
          "type": "configure",
          "name": "windows-laptop-msvc-x64-release"
        },
        {
          "type": "build",
          "name": "windows-laptop-msvc-x64-release"
        },
        {
          "type": "build",
          "name": "windows-laptop-msvc-x64-release-install"
        }
      ]
    },
    {
      "name": "windows-laptop-msvc-x64-release-installer-artifacts",
      "displayName": "Windows Laptop MSVC x64 Release Installer Artifacts",
      "description": "Configure, build, install, and package the Windows laptop x64 release installer.",
      "steps": [
        {
          "type": "configure",
          "name": "windows-laptop-msvc-x64-release"
        },
        {
          "type": "build",
          "name": "windows-laptop-msvc-x64-release-installer"
        }
      ]
    },
    {
      "name": "windows-msvc-arm64-release-artifacts",
      "displayName": "Windows MSVC ARM64 Release Artifacts",
      "description": "Configure and build the Windows ARM64 release artifact.",
      "steps": [
        {
          "type": "configure",
          "name": "windows-msvc-arm64-release"
        },
        {
          "type": "build",
          "name": "windows-msvc-arm64-release"
        },
        {
          "type": "build",
          "name": "windows-msvc-arm64-release-install"
        }
      ]
    },
    {
      "name": "windows-msvc-x86-release-artifacts",
      "displayName": "Windows MSVC x86 Release Artifacts",
      "description": "Optionally configure and build the Windows x86 release artifact when a compatible Qt kit is available.",
      "steps": [
        {
          "type": "configure",
          "name": "windows-msvc-x86-release-optional"
        },
        {
          "type": "build",
          "name": "windows-msvc-x86-release-optional"
        },
        {
          "type": "build",
          "name": "windows-msvc-x86-release-optional-install"
        }
      ]
    }
  ]
}
