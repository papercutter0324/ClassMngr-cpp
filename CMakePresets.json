{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },

    {
      "name": "qt-linux",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "/home/papercutter0324/Qt/6.11.1/gcc_64"
      }
    },
    {
      "name": "qt-macos",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "/Users/papercutter0324/Qt/6.11.1/macos"
      }
    },
    {
      "name": "qt-windows-desktop",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "D:/Development/Qt/6.11.1/msvc2022_64"
      }
    },
    {
      "name": "qt-windows-laptop",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "C:/Qt/6.11.1/msvc2022_64"
      }
    },
    {
      "name": "qt-windows-arm64",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_MSVC_ARM64_PREFIX}"
      }
    },

    {
      "name": "windows-msvc-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Visual Studio 18 2026"
    },
    {
      "name": "windows-desktop-base",
      "hidden": true,
      "inherits": [
        "windows-msvc-base",
        "qt-windows-desktop"
      ],
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "CLASSMNGR_PREFER_QT_ZLIB_FALLBACK": "ON"
      }
    },
    {
      "name": "windows-desktop-debug",
      "displayName": "Windows Desktop Debug",
      "inherits": "windows-desktop-base"
    },
    {
      "name": "windows-desktop-release",
      "displayName": "Windows Desktop Release",
      "inherits": "windows-desktop-base",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist/ClassMngr-windows-x64",
        "CLASSMNGR_RUN_WINDEPLOYQT": "ON"
      }
    },
    {
      "name": "windows-laptop-base",
      "hidden": true,
      "inherits": [
        "windows-msvc-base",
        "qt-windows-laptop"
      ],
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "windows-laptop-debug",
      "displayName": "Windows Laptop Debug",
      "inherits": "windows-laptop-base"
    },
    {
      "name": "windows-laptop-release",
      "displayName": "Windows Laptop Release",
      "inherits": "windows-laptop-base",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist/ClassMngr-windows-x64",
        "CLASSMNGR_RUN_WINDEPLOYQT": "ON"
      }
    },
    {
      "name": "windows-arm64-base",
      "hidden": true,
      "inherits": [
        "windows-msvc-base",
        "qt-windows-arm64"
      ],
      "architecture": {
        "value": "ARM64",
        "strategy": "set"
      }
    },
    {
      "name": "windows-arm64-debug",
      "displayName": "Windows ARM64 Debug",
      "inherits": "windows-arm64-base"
    },
    {
      "name": "windows-arm64-release",
      "displayName": "Windows ARM64 Release",
      "inherits": "windows-arm64-base",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist/ClassMngr-windows-arm64",
        "CLASSMNGR_RUN_WINDEPLOYQT": "ON"
      }
    },

    {
      "name": "linux-gcc-debug",
      "displayName": "Linux GCC Debug",
      "inherits": [
        "base",
        "qt-linux"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux GCC Release",
      "inherits": "linux-gcc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },

    {
      "name": "macos-clang-debug",
      "displayName": "macOS Clang Debug",
      "inherits": [
        "base",
        "qt-macos"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0"
      }
    },
    {
      "name": "macos-clang-release",
      "displayName": "macOS Clang Release",
      "inherits": "macos-clang-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist/ClassMngr-macos"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "windows-desktop-debug",
      "configurePreset": "windows-desktop-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-desktop-release",
      "configurePreset": "windows-desktop-release",
      "configuration": "Release"
    },
    {
      "name": "windows-desktop-release-install",
      "configurePreset": "windows-desktop-release",
      "configuration": "Release",
      "targets": [
        "INSTALL"
      ]
    },
    {
      "name": "windows-laptop-debug",
      "configurePreset": "windows-laptop-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-laptop-release",
      "configurePreset": "windows-laptop-release",
      "configuration": "Release"
    },
    {
      "name": "windows-laptop-release-install",
      "configurePreset": "windows-laptop-release",
      "configuration": "Release",
      "targets": [
        "INSTALL"
      ]
    },
    {
      "name": "windows-arm64-debug",
      "configurePreset": "windows-arm64-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-arm64-release",
      "configurePreset": "windows-arm64-release",
      "configuration": "Release"
    },
    {
      "name": "windows-arm64-release-install",
      "configurePreset": "windows-arm64-release",
      "configuration": "Release",
      "targets": [
        "INSTALL"
      ]
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug"
    },
    {
      "name": "linux-gcc-release",
      "configurePreset": "linux-gcc-release"
    },
    {
      "name": "macos-clang-debug",
      "configurePreset": "macos-clang-debug"
    },
    {
      "name": "macos-clang-release",
      "configurePreset": "macos-clang-release"
    },
    {
      "name": "macos-clang-release-install",
      "configurePreset": "macos-clang-release",
      "targets": [
        "install"
      ]
    }
  ],

  "workflowPresets": [
    {
      "name": "linux-gcc-release-artifacts",
      "displayName": "Linux GCC Release Artifacts",
      "description": "Configure and build the Linux release artifact.",
      "steps": [
        {
          "type": "configure",
          "name": "linux-gcc-release"
        },
        {
          "type": "build",
          "name": "linux-gcc-release"
        }
      ]
    },
    {
      "name": "macos-clang-universal-release-artifacts",
      "displayName": "macOS Clang Universal Release Artifacts",
      "description": "Configure and build the macOS arm64/x86_64 universal release artifact.",
      "steps": [
        {
          "type": "configure",
          "name": "macos-clang-release"
        },
        {
          "type": "build",
          "name": "macos-clang-release-install"
        }
      ]
    }
  ]
}
