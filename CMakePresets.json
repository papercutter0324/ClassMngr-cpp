{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },

    {
      "name": "qt-linux",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_LINUX_PREFIX}"
      }
    },
    {
      "name": "qt-macos",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_MACOS_PREFIX}"
      }
    },
    {
      "name": "qt-windows-x64",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_MSVC_X64_PREFIX}"
      }
    },
    {
      "name": "qt-windows-arm64",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_MSVC_ARM64_PREFIX}",
        "QT_HOST_PATH": "$env{QT_MSVC_X64_PREFIX}"
      }
    },

    {
      "name": "windows-msvc-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "toolset": "v145",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64-base",
      "hidden": true,
      "inherits": [
        "windows-msvc-base",
        "qt-windows-x64"
      ],
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "CLASSMNGR_PREFER_QT_ZLIB_FALLBACK": "ON"
      }
    },
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 Debug",
      "inherits": "windows-x64-base"
    },
    {
      "name": "windows-x64-phase0-visual",
      "displayName": "Windows x64 Phase 0 Visual Evidence",
      "inherits": "windows-x64-debug",
      "cacheVariables": {
        "CLASSMNGR_ENABLE_WINDOWS_QT_VISUAL_CAPTURE_TESTS": "ON"
      }
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release",
      "inherits": "windows-x64-base",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist/ClassMngr-windows-x64",
        "CLASSMNGR_RUN_WINDEPLOYQT": "ON"
      }
    },
    {
      "name": "windows-x64-native-base",
      "hidden": true,
      "inherits": "windows-msvc-base",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "CMAKE_VS_WINDOWS_TARGET_PLATFORM_VERSION": "10.0.26100.0",
        "CLASSMNGR_BUILD_QT_DESKTOP": "OFF",
        "CLASSMNGR_BUILD_WINDOWS_QT_TRANSITION": "OFF",
        "CLASSMNGR_BUILD_WINDOWS_NATIVE": "ON",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist/ClassMngr-windows-native-x64"
      }
    },
    {
      "name": "windows-x64-native-debug",
      "displayName": "Windows x64 Native Debug",
      "inherits": "windows-x64-native-base"
    },
    {
      "name": "windows-x64-native-release",
      "displayName": "Windows x64 Native Release",
      "inherits": "windows-x64-native-base",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist/ClassMngr-windows-native-x64"
      }
    },
    {
      "name": "windows-x64-winui-base",
      "hidden": true,
      "inherits": "windows-msvc-base",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "CMAKE_VS_WINDOWS_TARGET_PLATFORM_VERSION": "10.0.26100.0",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "CLASSMNGR_BUILD_QT_DESKTOP": "OFF",
        "CLASSMNGR_BUILD_WINDOWS_QT_TRANSITION": "OFF",
        "CLASSMNGR_BUILD_WINDOWS_NATIVE": "OFF",
        "CLASSMNGR_BUILD_WINDOWS_WINUI": "ON",
        "CLASSMNGR_WINDOWS_WINUI_STAGE_ROOT": "${sourceDir}/dist/ClassMngr-windows-winui-x64"
      }
    },
    {
      "name": "windows-x64-winui-debug",
      "displayName": "Windows x64 WinUI Debug",
      "inherits": "windows-x64-winui-base"
    },
    {
      "name": "windows-x64-winui-release",
      "displayName": "Windows x64 WinUI Release",
      "inherits": "windows-x64-winui-base",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-x86-winui-base",
      "hidden": true,
      "inherits": "windows-msvc-base",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      },
      "cacheVariables": {
        "CMAKE_VS_WINDOWS_TARGET_PLATFORM_VERSION": "10.0.26100.0",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "CLASSMNGR_BUILD_QT_DESKTOP": "OFF",
        "CLASSMNGR_BUILD_WINDOWS_QT_TRANSITION": "OFF",
        "CLASSMNGR_BUILD_WINDOWS_NATIVE": "OFF",
        "CLASSMNGR_BUILD_WINDOWS_WINUI": "ON",
        "CLASSMNGR_WINDOWS_WINUI_STAGE_ROOT": "${sourceDir}/dist/ClassMngr-windows-winui-x86"
      }
    },
    {
      "name": "windows-x86-winui-debug",
      "displayName": "Windows x86 WinUI Debug",
      "inherits": "windows-x86-winui-base"
    },
    {
      "name": "windows-x86-winui-release",
      "displayName": "Windows x86 WinUI Release",
      "inherits": "windows-x86-winui-base",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-arm64-base",
      "hidden": true,
      "inherits": [
        "windows-msvc-base",
        "qt-windows-arm64"
      ],
      "architecture": {
        "value": "ARM64",
        "strategy": "set"
      }
    },
    {
      "name": "windows-arm64-debug",
      "displayName": "Windows ARM64 Debug",
      "inherits": "windows-arm64-base"
    },
    {
      "name": "windows-arm64-phase0-visual",
      "displayName": "Windows ARM64 Phase 0 Visual Evidence",
      "inherits": "windows-arm64-debug",
      "cacheVariables": {
        "CLASSMNGR_ENABLE_WINDOWS_QT_VISUAL_CAPTURE_TESTS": "ON"
      }
    },
    {
      "name": "windows-arm64-release",
      "displayName": "Windows ARM64 Release",
      "inherits": "windows-arm64-base",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist/ClassMngr-windows-arm64",
        "CLASSMNGR_RUN_WINDEPLOYQT": "ON"
      }
    },

    {
      "name": "linux-gcc-debug",
      "displayName": "Linux GCC Debug",
      "inherits": [
        "base",
        "qt-linux"
      ],
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux GCC Release",
      "inherits": "linux-gcc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },

    {
      "name": "macos-clang-debug",
      "displayName": "macOS Clang Debug",
      "inherits": [
        "base",
        "qt-macos"
      ],
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0"
      }
    },
    {
      "name": "macos-clang-release",
      "displayName": "macOS Clang Release",
      "inherits": "macos-clang-debug",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist/ClassMngr-macos"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-phase0-visual",
      "configurePreset": "windows-x64-phase0-visual",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-release-install",
      "configurePreset": "windows-x64-release",
      "configuration": "Release",
      "targets": [
        "INSTALL"
      ]
    },
    {
      "name": "windows-x64-native-debug",
      "configurePreset": "windows-x64-native-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-native-release",
      "configurePreset": "windows-x64-native-release",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-winui-debug",
      "configurePreset": "windows-x64-winui-debug",
      "configuration": "Debug",
      "targets": [
        "ClassMngrWindowsWinUI"
      ]
    },
    {
      "name": "windows-x64-winui-release",
      "configurePreset": "windows-x64-winui-release",
      "configuration": "Release",
      "targets": [
        "ClassMngrWindowsWinUI"
      ]
    },
    {
      "name": "windows-x86-winui-debug",
      "configurePreset": "windows-x86-winui-debug",
      "configuration": "Debug",
      "targets": [
        "ClassMngrWindowsWinUI"
      ]
    },
    {
      "name": "windows-x86-winui-release",
      "configurePreset": "windows-x86-winui-release",
      "configuration": "Release",
      "targets": [
        "ClassMngrWindowsWinUI"
      ]
    },
    {
      "name": "windows-x64-native-release-install",
      "configurePreset": "windows-x64-native-release",
      "configuration": "Release",
      "targets": [
        "INSTALL"
      ]
    },
    {
      "name": "windows-x64-release-installer",
      "configurePreset": "windows-x64-release",
      "configuration": "Release",
      "targets": [
        "ClassMngrInstaller"
      ]
    },
    {
      "name": "windows-arm64-debug",
      "configurePreset": "windows-arm64-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-arm64-phase0-visual",
      "configurePreset": "windows-arm64-phase0-visual",
      "configuration": "Debug"
    },
    {
      "name": "windows-arm64-release",
      "configurePreset": "windows-arm64-release",
      "configuration": "Release"
    },
    {
      "name": "windows-arm64-release-install",
      "configurePreset": "windows-arm64-release",
      "configuration": "Release",
      "targets": [
        "INSTALL"
      ]
    },
    {
      "name": "windows-arm64-release-installer",
      "configurePreset": "windows-arm64-release",
      "configuration": "Release",
      "targets": [
        "ClassMngrInstaller"
      ]
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug"
    },
    {
      "name": "linux-gcc-release",
      "configurePreset": "linux-gcc-release"
    },
    {
      "name": "macos-clang-debug",
      "configurePreset": "macos-clang-debug"
    },
    {
      "name": "macos-clang-release",
      "configurePreset": "macos-clang-release"
    },
    {
      "name": "macos-clang-release-install",
      "configurePreset": "macos-clang-release",
      "targets": [
        "install"
      ]
    },
    {
      "name": "macos-clang-release-installer",
      "configurePreset": "macos-clang-release",
      "targets": [
        "ClassMngrInstaller"
      ]
    }
  ],

  "workflowPresets": [
    {
      "name": "linux-gcc-release-artifacts",
      "displayName": "Linux GCC Release Artifacts",
      "description": "Configure and build the Linux release artifact.",
      "steps": [
        {
          "type": "configure",
          "name": "linux-gcc-release"
        },
        {
          "type": "build",
          "name": "linux-gcc-release"
        }
      ]
    },
    {
      "name": "macos-clang-universal-release-artifacts",
      "displayName": "macOS Clang Universal Release Artifacts",
      "description": "Configure and build the macOS arm64/x86_64 universal release artifact.",
      "steps": [
        {
          "type": "configure",
          "name": "macos-clang-release"
        },
        {
          "type": "build",
          "name": "macos-clang-release-installer"
        }
      ]
    }
  ]
}
