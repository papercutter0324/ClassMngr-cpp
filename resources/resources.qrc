<RCC>

    <!-- =====================================================
         Assets Root
         Everything lives under :/assets/
         ===================================================== -->

    <!-- Fonts -->
    <qresource prefix="/assets/fonts">
        <file alias="Inter.ttc">assets/fonts/Inter.ttc</file>
        <file alias="PretendardVariable.ttf">assets/fonts/PretendardVariable.ttf</file>
    </qresource>

    <!-- Icons -->
    <qresource prefix="/assets/icons">
        <file alias="icon_256x256.png">assets/icons/icon_256x256.png</file>
        <file alias="app_icon.ico">assets/icons/app_icon.ico</file>
    </qresource>

    <!-- Images -->
    <qresource prefix="/assets/images">
        <!-- future images -->
    </qresource>

    <!-- Splash -->
    <qresource prefix="/assets/splash">
        <file alias="splash.png">assets/splash/splash.png</file>
    </qresource>

    <!-- Styles -->
    <qresource prefix="/assets/styles">
        <file alias="dark.qss">assets/styles/dark.qss</file>
        <file alias="light.qss">assets/styles/light.qss</file>
    </qresource>

    <!-- Templates -->
    <qresource prefix="/assets/templates">
        <!-- future templates -->
    </qresource>

    <!-- Campuses -->
    <qresource prefix="/assets/campuses">
        <file alias="placeholder.json">assets/campuses/placeholder.json</file>
    </qresource>

    <!-- Translations -->
    <qresource prefix="/assets/translations">
        <file alias="ClassMngr_en_US.ts">assets/translations/ClassMngr_en_US.ts</file>
    </qresource>

</RCC>
