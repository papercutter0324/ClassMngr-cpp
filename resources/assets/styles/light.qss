QWidget {
    background-color: #e9e8e3;
    color: #27313a;
    selection-background-color: #cbdbe7;
    selection-color: #1f2d38;
}

QMainWindow,
QDialog,
QWidget[role="default"],
QWidget[role="roster_page"],
QWidget[role="schedule"],
QWidget[role="speaking_evals"],
QWidget[role="class_info"],
QWidget[role="teacher_info"],
QWidget[role="my_info"],
QWidget[role="sub_prep"],
QWidget[role="campus_info"] {
    background-color: #e9e8e3;
    color: #27313a;
}

QPdfView#pdfViewerView {
    background-color: #deded8;
    border: 2px solid #d2d0c9;
    border-radius: 6px;
}

QLabel {
    background: transparent;
}

QWidget#scheduleHeader,
QWidget#classTimeRow,
QWidget#startTimeControls {
    background: transparent;
}

QLabel#pageTitle {
    color: #24303a;
    font-weight: 700;
}

QLabel#pageSubtitle,
QLabel#sectionSubtitle {
    color: #66727a;
}

QLabel#sectionTitle,
QLabel[role="header"],
QLabel[role="section_header"],
QLabel[role="section_header_center"] {
    color: #24303a;
    font-weight: 700;
}

QFrame[role="card"],
QWidget[role="card"],
QFrame#sectionCard,
QWidget#sectionCard {
    background-color: #f5f3ee;
    border: 2px solid #d2d0c9;
    border-radius: 8px;
}

QTreeWidget#sidebarTree {
    border-color: #d2d0c9;
}

QFrame[role="card"]:hover,
QWidget[role="card"]:hover,
QFrame#sectionCard:hover,
QWidget#sectionCard:hover {
    border-color: #a8b2b8;
}

QFrame[role="separator"] {
    color: #c5c7c3;
    background-color: #c5c7c3;
    max-height: 1px;
    border: none;
}

QFrame#campusMapDivider {
    color: #858f94;
    background-color: #858f94;
    border: none;
}

QLineEdit,
QPlainTextEdit,
QTextEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox,
QDateEdit,
QTimeEdit,
QDateTimeEdit,
QWidget[role="input"] {
    background-color: #f5f3ee;
    color: #27313a;
    border: 1px solid #cbc9c2;
    border-radius: 6px;
    padding: 5px 8px;
}

QCheckBox#zoomNotAvailableCheck,
QCheckBox#printerDriverUrlUnavailableCheck,
QCheckBox#photocopierCodeUnavailableCheck {
    background: transparent;
    spacing: 6px;
}

QCheckBox#zoomNotAvailableCheck::indicator,
QCheckBox#printerDriverUrlUnavailableCheck::indicator,
QCheckBox#photocopierCodeUnavailableCheck::indicator {
    width: 16px;
    height: 16px;
    background-color: #f5f3ee;
    border: 1px solid #cbc9c2;
    border-radius: 4px;
}

QCheckBox#zoomNotAvailableCheck::indicator:hover,
QCheckBox#printerDriverUrlUnavailableCheck::indicator:hover,
QCheckBox#photocopierCodeUnavailableCheck::indicator:hover {
    border-color: #4b6f91;
}

QCheckBox#zoomNotAvailableCheck::indicator:checked,
QCheckBox#printerDriverUrlUnavailableCheck::indicator:checked,
QCheckBox#photocopierCodeUnavailableCheck::indicator:checked {
    image: url(:/assets/icons/check_light.svg);
    background-color: #f5f3ee;
    border-color: #4b6f91;
}

QComboBox:editable,
QComboBox:!editable {
    background: #f5f3ee;
}

QComboBox QLineEdit {
    background: #f5f3ee;
    color: #27313a;
    border: none;
    padding: 0;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus,
QDateEdit:focus,
QTimeEdit:focus,
QDateTimeEdit:focus {
    border-color: #4b6f91;
}

QLineEdit:disabled,
QPlainTextEdit:disabled,
QTextEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QComboBox:disabled,
QDateEdit:disabled,
QTimeEdit:disabled,
QDateTimeEdit:disabled {
    background-color: #deded8;
    color: #858f94;
    border-color: #d2d0c9;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    background-color: #f5f3ee;
    border-left: 1px solid #cbc9c2;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    width: 28px;
}

QComboBox {
    padding-right: 34px;
}

QComboBox::drop-down:hover {
    background-color: #deded8;
}

QComboBox::drop-down:pressed {
    background-color: #d2d0c9;
}

QComboBox::down-arrow {
    image: url(:/assets/icons/combo_arrow_light.svg);
    width: 10px;
    height: 6px;
}

QComboBox::drop-down:disabled {
    background-color: #deded8;
    border-left-color: #d2d0c9;
}

QSpinBox,
QTimeEdit {
    padding-right: 30px;
}

QSpinBox::up-button,
QSpinBox::down-button,
QTimeEdit::up-button,
QTimeEdit::down-button {
    subcontrol-origin: border;
    width: 24px;
    background-color: #ebeae5;
    border-left: 1px solid #c5c7c3;
}

QSpinBox::up-button,
QTimeEdit::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 6px;
}

QSpinBox::down-button,
QTimeEdit::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 6px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QTimeEdit::up-button:hover,
QTimeEdit::down-button:hover {
    background-color: #deded8;
}

QSpinBox::up-arrow,
QTimeEdit::up-arrow {
    image: url(:/assets/icons/spin_up_light.svg);
    width: 10px;
    height: 6px;
}

QSpinBox::down-arrow,
QTimeEdit::down-arrow {
    image: url(:/assets/icons/combo_arrow_light.svg);
    width: 10px;
    height: 6px;
}

QComboBox QAbstractItemView {
    background-color: #f5f3ee;
    color: #27313a;
    border: 2px solid #c5c7c3;
    selection-background-color: #cbdbe7;
    selection-color: #1f2d38;
}

QPushButton {
    background-color: #f5f3ee;
    color: #27313a;
    border: 2px solid #c5c7c3;
    border-radius: 6px;
    padding: 6px 12px;
    min-height: 24px;
}

QPushButton:hover {
    background-color: #ebe9e3;
    border-color: #a8b2b8;
}

QPushButton:pressed {
    background-color: #dfdfd9;
}

QPushButton:disabled {
    background-color: #deded8;
    color: #858f94;
    border-color: #d2d0c9;
}

QPushButton#primaryButton,
QPushButton[role="primary"] {
    background-color: #4b6f91;
    color: #fbfaf7;
    border: 2px solid #4b6f91;
    font-weight: 600;
}

QPushButton#primaryButton:hover,
QPushButton[role="primary"]:hover {
    background-color: #3f6283;
    border-color: #3f6283;
}

QPushButton#primaryButton:checked,
QPushButton[role="primary"]:checked {
    background-color: #345471;
    border-color: #243d53;
}

QPushButton#primaryButton:checked:hover,
QPushButton[role="primary"]:checked:hover {
    background-color: #2f4a63;
    border-color: #243d53;
}

QPushButton#primaryButton:pressed,
QPushButton[role="primary"]:pressed {
    background-color: #345471;
    border-color: #345471;
}

QPushButton#primaryButton:disabled,
QPushButton[role="primary"]:disabled {
    background-color: #deded8;
    color: #858f94;
    border-color: #d2d0c9;
}

QPushButton[role="button_footer"] {
    background-color: #f5f3ee;
    border: 2px solid #c5c7c3;
    border-radius: 6px;
    padding: 6px 12px;
    min-height: 28px;
}

QPushButton[role="button_footer"]:hover {
    background-color: #ebe9e3;
}

QPushButton[role="icon_button"] {
    background-color: #f5f3ee;
    border: 2px solid #c5c7c3;
    border-radius: 6px;
    padding: 0;
    min-height: 24px;
    min-width: 28px;
}

QPushButton[role="icon_button"]:hover {
    background-color: #ebe9e3;
    border-color: #a8b2b8;
}

QPushButton[role="icon_button"]:pressed {
    background-color: #dfdfd9;
}

QMenuBar {
    background-color: #f5f3ee;
    color: #27313a;
    border-bottom: 1px solid #d2d0c9;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 8px;
}

QMenuBar::item:selected {
    background-color: #deded8;
}

QMenu {
    background-color: #f5f3ee;
    color: #27313a;
    border: 1px solid #c5c7c3;
}

QMenu::item {
    padding: 5px 24px;
}

QMenu::item:selected {
    background-color: #cbdbe7;
    color: #1f2d38;
}

QMenu::item:disabled {
    color: #858f94;
}

QTabWidget#subPrepGradeTabs::pane,
QTabWidget#subPrepClassTabs::pane,
QTabWidget#myInfoGradeTabs::pane,
QTabWidget#myInfoClassTabs::pane {
    border: 0;
    background: transparent;
    margin-top: 8px;
}

QTabBar#subPrepGradeTabBar::tab,
QTabBar#subPrepClassTabBar::tab,
QTabBar#myInfoGradeTabBar::tab,
QTabBar#myInfoClassTabBar::tab {
    background-color: #deded8;
    color: #27313a;
    border: 1px solid #c5c7c3;
    border-radius: 7px;
    margin-right: 6px;
}

QTabBar#subPrepGradeTabBar,
QTabBar#subPrepClassTabBar,
QTabBar#myInfoGradeTabBar,
QTabBar#myInfoClassTabBar {
    qproperty-drawBase: 0;
}

QTabBar#subPrepGradeTabBar::tab,
QTabBar#myInfoGradeTabBar::tab {
    padding: 7px 22px;
}

QTabBar#subPrepClassTabBar::tab,
QTabBar#myInfoClassTabBar::tab {
    padding: 6px 14px;
}

QTabBar#subPrepGradeTabBar::tab:hover,
QTabBar#subPrepClassTabBar::tab:hover,
QTabBar#myInfoGradeTabBar::tab:hover,
QTabBar#myInfoClassTabBar::tab:hover {
    background-color: #d2d0c9;
    border-color: #a8b2b8;
}

QTabBar#subPrepGradeTabBar::tab:selected,
QTabBar#subPrepClassTabBar::tab:selected,
QTabBar#myInfoGradeTabBar::tab:selected,
QTabBar#myInfoClassTabBar::tab:selected {
    background-color: #cbdbe7;
    color: #1f2d38;
    border-color: #4b6f91;
}

QTableView,
QTableWidget,
QTableView[role="roster_table"],
QTableWidget[role="schedule_table"] {
    background-color: #f5f3ee;
    alternate-background-color: #e5e4de;
    color: #27313a;
    gridline-color: #d2d0c9;
    border: 1px solid #c5c7c3;
    selection-background-color: #cbdbe7;
    selection-color: #1f2d38;
}

QTableView::item,
QTableWidget::item {
    padding: 4px;
    border: none;
}

QTableWidget[role="schedule_table"] {
    border: none;
    gridline-color: transparent;
}

QTableWidget[role="schedule_table"]::item {
    border: none;
}

QTableWidget[role="schedule_table"] QHeaderView::section {
    border: none;
    border-right: 1px solid #c5c7c3;
    border-bottom: 1px solid #c5c7c3;
}

QHeaderView {
    background-color: #e9e8e3;
    color: #546169;
}

QHeaderView::section {
    background-color: #deded8;
    color: #546169;
    border: none;
    border-right: 1px solid #c5c7c3;
    border-bottom: 1px solid #c5c7c3;
    padding: 4px;
}

QHeaderView::section:hover {
    background-color: #d2d0c9;
}

QTableCornerButton::section {
    background-color: #deded8;
    border: none;
}

QScrollArea {
    border: none;
    background: transparent;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    border: none;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #b6b9b6;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #858f94;
}

QScrollBar:horizontal {
    background: transparent;
    border: none;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #b6b9b6;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #858f94;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: none;
    width: 0;
    height: 0;
}

QLabel[role="schedule_cell"],
QLabel[role="schedule_multi"] {
    border-radius: 6px;
    padding: 4px;
}

QLabel[role="schedule_empty"] {
    border-radius: 6px;
    padding: 6px;
}

QSplitter::handle {
    background: transparent;
}

QToolTip {
    background-color: #f5f3ee;
    color: #27313a;
    border: 1px solid #c5c7c3;
    padding: 4px;
}
