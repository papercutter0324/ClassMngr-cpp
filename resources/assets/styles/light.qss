QWidget {
    background-color: #e9e8e3;
    color: #27313a;
    selection-background-color: #cbdbe7;
    selection-color: #1f2d38;
}

QMainWindow,
QDialog,
QWidget[role="default"],
QWidget[role="roster_page"],
QWidget[role="schedule"],
QWidget[role="speaking_evals"],
QWidget[role="classes"],
QWidget[role="class_info"],
QWidget[role="teacher_info"],
QWidget[role="my_info"],
QWidget[role="sub_prep"],
QWidget[role="campus_info"] {
    background-color: #e9e8e3;
    color: #27313a;
}

QPdfView#pdfViewerView {
    background-color: #deded8;
    border: 2px solid #d2d0c9;
    border-radius: 6px;
}

QPdfView#pdfViewerView[pdfViewerBackground="white"],
QWidget[pdfViewerBackground="white"] {
    background-color: #ffffff;
}

QPdfView#pdfViewerView[pdfViewerBackground="black"],
QWidget[pdfViewerBackground="black"] {
    background-color: #000000;
}

QLabel {
    background: transparent;
}

QWidget#scheduleHeader,
QWidget#classTimeRow,
QWidget#startTimeControls {
    background: transparent;
}

QLabel#pageTitle {
    color: #24303a;
    font-weight: 700;
}

QLabel#pageSubtitle,
QLabel#sectionSubtitle {
    color: #66727a;
}

QLabel#sectionTitle,
QLabel[role="header"],
QLabel[role="section_header"],
QLabel[role="section_header_center"] {
    color: #24303a;
    font-weight: 700;
}

QLabel#signatureImagePreview {
    background-color: #ffffff;
    color: #66727a;
    border: 1px dashed #a8b2b8;
    border-radius: 6px;
}

QFrame[role="card"],
QWidget[role="card"],
QFrame#sectionCard,
QWidget#sectionCard {
    background-color: #f5f3ee;
    border: 2px solid #d2d0c9;
    border-radius: 8px;
}

QTreeWidget#sidebarTree {
    border-color: #d2d0c9;
}

QFrame[role="card"]:hover,
QWidget[role="card"]:hover,
QFrame#sectionCard:hover,
QWidget#sectionCard:hover {
    border-color: #a8b2b8;
}

QFrame#noDatabaseBanner {
    background-color: #eef5fa;
    border: 1px solid #9db8cc;
    border-radius: 0px;
}

QLabel#noDatabaseMessage {
    color: #24303a;
    font-weight: 600;
}

QPushButton#noDatabaseOpenButton,
QPushButton#noDatabaseNewButton {
    background-color: #e3edf5;
    border: 1px solid #8ca9bd;
}

QPushButton#noDatabaseOpenButton:hover,
QPushButton#noDatabaseNewButton:hover {
    background-color: #d2e3ef;
    border-color: #5f849e;
}

QFrame[role="separator"] {
    color: #c5c7c3;
    background-color: #c5c7c3;
    max-height: 1px;
    border: none;
}

QFrame#campusMapDivider {
    color: #858f94;
    background-color: #858f94;
    border: none;
}

QLineEdit,
QPlainTextEdit,
QTextEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox,
QDateEdit,
QTimeEdit,
QDateTimeEdit,
QWidget[role="input"] {
    background-color: #f5f3ee;
    color: #27313a;
    border: 1px solid #cbc9c2;
    border-radius: 6px;
    padding: 5px 8px;
}

QCheckBox,
QRadioButton {
    background: transparent;
    spacing: 6px;
}

QAbstractItemView::indicator,
QCheckBox::indicator,
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    background-color: #fcfcfc;
    border: 2px solid #7f8c8d;
}

QAbstractItemView::indicator,
QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QAbstractItemView::indicator:hover,
QCheckBox::indicator:hover,
QCheckBox::indicator:focus,
QRadioButton::indicator:hover,
QRadioButton::indicator:focus {
    border-color: #3daee9;
}

QAbstractItemView::indicator:checked,
QCheckBox::indicator:checked {
    image: url(:/assets/icons/check.png);
    background-color: #3daee9;
    border-color: #3daee9;
}

QAbstractItemView::indicator:indeterminate,
QCheckBox::indicator:indeterminate {
    background-color: #3daee9;
    border-color: #3daee9;
}

QRadioButton::indicator:checked {
    image: url(:/assets/icons/radio_checked.png);
    background-color: #fcfcfc;
    border: 2px solid #3daee9;
}

QAbstractItemView::indicator:disabled,
QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled {
    background-color: #eff0f1;
    border-color: #c5c7c3;
}

QAbstractItemView::indicator:checked:disabled,
QCheckBox::indicator:checked:disabled {
    image: url(:/assets/icons/check.png);
    background-color: #60869a;
    border-color: #60869a;
}

QComboBox:editable,
QComboBox:!editable {
    background: #f5f3ee;
}

QComboBox QLineEdit {
    background: #f5f3ee;
    color: #27313a;
    border: none;
    padding: 0;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus,
QDateEdit:focus,
QTimeEdit:focus,
QDateTimeEdit:focus {
    border: 2px solid #3daee9;
    padding: 4px 7px;
}

QLineEdit:hover,
QPlainTextEdit:hover,
QTextEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QComboBox:hover,
QDateEdit:hover,
QTimeEdit:hover,
QDateTimeEdit:hover {
    border-color: #3daee9;
}

QLineEdit:disabled,
QPlainTextEdit:disabled,
QTextEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QComboBox:disabled,
QDateEdit:disabled,
QTimeEdit:disabled,
QDateTimeEdit:disabled {
    background-color: #deded8;
    color: #858f94;
    border-color: #d2d0c9;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    background-color: #f5f3ee;
    border-left: 1px solid #cbc9c2;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    width: 28px;
}

QComboBox {
    padding-right: 34px;
}

QComboBox::drop-down:hover {
    background-color: #deded8;
}

QComboBox::drop-down:pressed {
    background-color: #d2d0c9;
}

QComboBox::down-arrow {
    image: url(:/assets/icons/combo_arrow_light.svg);
    width: 10px;
    height: 6px;
}

QComboBox::drop-down:disabled {
    background-color: #deded8;
    border-left-color: #d2d0c9;
}

QSpinBox,
QTimeEdit {
    padding-right: 30px;
}

QSpinBox::up-button,
QSpinBox::down-button,
QTimeEdit::up-button,
QTimeEdit::down-button {
    subcontrol-origin: border;
    width: 24px;
    background-color: #ebeae5;
    border-left: 1px solid #c5c7c3;
}

QSpinBox::up-button,
QTimeEdit::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 6px;
}

QSpinBox::down-button,
QTimeEdit::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 6px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QTimeEdit::up-button:hover,
QTimeEdit::down-button:hover {
    background-color: #deded8;
}

QSpinBox::up-arrow,
QTimeEdit::up-arrow {
    image: url(:/assets/icons/spin_up_light.svg);
    width: 10px;
    height: 6px;
}

QSpinBox::down-arrow,
QTimeEdit::down-arrow {
    image: url(:/assets/icons/combo_arrow_light.svg);
    width: 10px;
    height: 6px;
}

QComboBox QAbstractItemView {
    background-color: #f5f3ee;
    color: #27313a;
    border: 2px solid #c5c7c3;
    selection-background-color: #cbdbe7;
    selection-color: #1f2d38;
}

QPushButton {
    background-color: #fcfcfc;
    color: #232629;
    border: 2px solid #b0b5bb;
    border-radius: 6px;
    padding: 6px 12px;
    min-height: 24px;
}

QPushButton:hover {
    background-color: #f5f5f5;
    border-color: #3daee9;
}

QPushButton:pressed {
    background-color: #3daee9;
    color: #ffffff;
    border-color: #3daee9;
}

QPushButton:checked {
    background-color: #3daee9;
    color: #ffffff;
    border-color: #3daee9;
}

QPushButton:disabled {
    background-color: #deded8;
    color: #858f94;
    border-color: #d2d0c9;
}

QPushButton[role="button_footer"] {
    background-color: #fcfcfc;
    border: 2px solid #b0b5bb;
    border-radius: 6px;
    padding: 6px 12px;
    min-height: 28px;
}

QPushButton[role="button_footer"]:hover {
    background-color: #f5f5f5;
    border-color: #3daee9;
}

QPushButton[role="button_footer"]:pressed,
QPushButton[role="button_footer"]:checked {
    background-color: #3daee9;
    color: #ffffff;
    border-color: #3daee9;
}

QPushButton[role="button_footer"]:disabled {
    background-color: #deded8;
    color: #858f94;
    border-color: #d2d0c9;
}

QPushButton[role="icon_button"] {
    background-color: #fcfcfc;
    border: 2px solid #b0b5bb;
    border-radius: 6px;
    padding: 0;
    min-height: 24px;
    min-width: 28px;
}

QPushButton[role="icon_button"]:hover {
    background-color: #f5f5f5;
    border-color: #3daee9;
}

QPushButton[role="icon_button"]:pressed,
QPushButton[role="icon_button"]:checked {
    background-color: #3daee9;
    color: #ffffff;
    border-color: #3daee9;
}

QPushButton[role="icon_button"]:disabled {
    background-color: #deded8;
    color: #858f94;
    border-color: #d2d0c9;
}

QMenuBar {
    background-color: #f5f3ee;
    color: #27313a;
    border-bottom: 1px solid #d2d0c9;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 8px;
}

QMenuBar::item:selected {
    background-color: #deded8;
}

QMenu {
    background-color: #f5f3ee;
    color: #27313a;
    border: 1px solid #c5c7c3;
}

QMenu::item {
    padding: 5px 24px;
}

QMenu::item:selected {
    background-color: #cbdbe7;
    color: #1f2d38;
}

QMenu::item:disabled {
    color: #858f94;
}

QTabWidget#subPrepGradeTabs::pane,
QTabWidget#subPrepClassTabs::pane,
QTabWidget#myInfoGradeTabs::pane,
QTabWidget#myInfoClassTabs::pane,
QTabWidget[uniformTabKind="grade"]::pane,
QTabWidget[uniformTabKind="class"]::pane,
QTabWidget[uniformTabKind="section"]::pane {
    border: 0;
    background: transparent;
    margin-top: 8px;
}

QTabBar#subPrepGradeTabBar::tab,
QTabBar#subPrepClassTabBar::tab,
QTabBar#myInfoGradeTabBar::tab,
QTabBar#myInfoClassTabBar::tab,
QTabBar[uniformTabKind="grade"]::tab,
QTabBar[uniformTabKind="class"]::tab,
QTabBar[uniformTabKind="section"]::tab {
    background-color: #deded8;
    color: #27313a;
    border: 1px solid #c5c7c3;
    border-radius: 7px;
    margin-right: 6px;
}

QTabBar#subPrepGradeTabBar,
QTabBar#subPrepClassTabBar,
QTabBar#myInfoGradeTabBar,
QTabBar#myInfoClassTabBar,
QTabBar[uniformTabKind="grade"],
QTabBar[uniformTabKind="class"],
QTabBar[uniformTabKind="section"] {
    qproperty-drawBase: 0;
    qproperty-navigationTabFillColor: #deded8;
    qproperty-navigationTabBorderColor: #c5c7c3;
    qproperty-navigationTabHoverColor: #f5f5f5;
    qproperty-navigationTabSelectedColor: #3daee9;
    qproperty-navigationTabTextColor: #27313a;
}

UniformWidthTabBar QToolButton#ScrollLeftButton,
UniformWidthTabBar QToolButton#ScrollRightButton {
    background-color: #f5f3ee;
    color: #27313a;
    border: 1px solid #8c969c;
    border-radius: 6px;
}

UniformWidthTabBar QToolButton#ScrollLeftButton:hover,
UniformWidthTabBar QToolButton#ScrollRightButton:hover {
    background-color: #e5eef5;
    border-color: #2d7ca3;
}

UniformWidthTabBar QToolButton#ScrollLeftButton:pressed,
UniformWidthTabBar QToolButton#ScrollRightButton:pressed {
    background-color: #cbdbe7;
    border-color: #246687;
}

UniformWidthTabBar QToolButton#ScrollLeftButton:disabled,
UniformWidthTabBar QToolButton#ScrollRightButton:disabled {
    background-color: #e1dfda;
    color: #92999d;
    border-color: #bdc2c4;
}

QTabBar#subPrepGradeTabBar::tab,
QTabBar#subPrepClassTabBar::tab,
QTabBar#myInfoGradeTabBar::tab,
QTabBar#myInfoClassTabBar::tab,
QTabBar[uniformTabKind="grade"]::tab,
QTabBar[uniformTabKind="class"]::tab,
QTabBar[uniformTabKind="section"]::tab {
    padding: 6px 14px;
}

QTabBar#subPrepGradeTabBar::tab:hover,
QTabBar#subPrepClassTabBar::tab:hover,
QTabBar#myInfoGradeTabBar::tab:hover,
QTabBar#myInfoClassTabBar::tab:hover,
QTabBar[uniformTabKind="grade"]::tab:hover,
QTabBar[uniformTabKind="class"]::tab:hover,
QTabBar[uniformTabKind="section"]::tab:hover {
    background-color: #f5f5f5;
    border-color: #3daee9;
}

QTabBar#subPrepGradeTabBar::tab:selected,
QTabBar#subPrepClassTabBar::tab:selected,
QTabBar#myInfoGradeTabBar::tab:selected,
QTabBar#myInfoClassTabBar::tab:selected,
QTabBar[uniformTabKind="grade"]::tab:selected,
QTabBar[uniformTabKind="class"]::tab:selected,
QTabBar[uniformTabKind="section"]::tab:selected {
    background-color: #3daee9;
    color: #ffffff;
    border-color: #3daee9;
}

QTableView,
QTableWidget,
QTableView[role="roster_table"],
QTableWidget[role="schedule_table"] {
    background-color: #f5f3ee;
    alternate-background-color: #e5e4de;
    color: #27313a;
    gridline-color: #d2d0c9;
    border: 1px solid #c5c7c3;
    selection-background-color: #cbdbe7;
    selection-color: #1f2d38;
}

QTableView::item,
QTableWidget::item {
    padding: 4px;
    border: none;
}

QTableWidget[role="schedule_table"] {
    border: none;
    gridline-color: transparent;
}

QTableWidget[role="schedule_table"]::item {
    border: none;
}

QTableWidget[role="schedule_table"] QHeaderView::section,
QTableWidget[role="schedule_table"] QHeaderView::section:hover,
QTableWidget[role="schedule_table"] QHeaderView::section:pressed {
    background-color: #deded8;
    color: #546169;
    border: none;
    border-right: 1px solid #c5c7c3;
    border-bottom: 1px solid #c5c7c3;
}

QHeaderView {
    background-color: #e9e8e3;
    color: #546169;
}

QHeaderView::section {
    background-color: #deded8;
    color: #546169;
    border: none;
    border-right: 1px solid #c5c7c3;
    border-bottom: 1px solid #c5c7c3;
    padding: 4px;
}

QHeaderView::section:hover {
    background-color: #d2d0c9;
}

QTableCornerButton::section {
    background-color: #deded8;
    border: none;
}

QScrollArea {
    border: none;
    background: transparent;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    border: none;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #b6b9b6;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #858f94;
}

QScrollBar:horizontal {
    background: transparent;
    border: none;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #b6b9b6;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #858f94;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: none;
    width: 0;
    height: 0;
}

QLabel[role="schedule_cell"],
QLabel[role="schedule_multi"] {
    border: 1px solid #000000;
    border-radius: 6px;
    padding: 4px;
}

QLabel[role="schedule_empty"] {
    border-radius: 6px;
    padding: 6px;
}

QLabel[role="schedule_empty"][slot_state="essay"],
QLabel[role="schedule_empty"][slot_state="lunch"] {
    border: 1px solid #000000;
}

QSplitter::handle {
    background: transparent;
}

QToolTip {
    background-color: #f5f3ee;
    color: #27313a;
    border: 1px solid #c5c7c3;
    padding: 4px;
}
