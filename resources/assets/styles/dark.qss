QWidget {
    background-color: #2b2b2b;
    color: #f0f0f0;
    selection-background-color: #0a84ff;
    selection-color: #ffffff;
}

QMainWindow,
QDialog,
QWidget[role="default"],
QWidget[role="roster_page"],
QWidget[role="schedule"],
QWidget[role="speaking_evals"],
QWidget[role="classes"],
QWidget[role="class_info"],
QWidget[role="teacher_info"],
QWidget[role="my_info"],
QWidget[role="sub_prep"],
QWidget[role="campus_info"] {
    background-color: #2b2b2b;
    color: #f0f0f0;
}

QPdfView#pdfViewerView {
    background-color: #1e1e1e;
    border: 2px solid #454545;
    border-radius: 6px;
}

QPdfView#pdfViewerView[pdfViewerBackground="white"],
QWidget[pdfViewerBackground="white"] {
    background-color: #ffffff;
}

QPdfView#pdfViewerView[pdfViewerBackground="black"],
QWidget[pdfViewerBackground="black"] {
    background-color: #000000;
}

QLabel {
    background: transparent;
}

QWidget#scheduleHeader,
QWidget#classTimeRow,
QWidget#startTimeControls {
    background: transparent;
}

QLabel#pageTitle {
    color: #f5f5f5;
    font-weight: 700;
}

QLabel#pageSubtitle,
QLabel#sectionSubtitle {
    color: #a8b0bd;
}

QLabel#sectionTitle,
QLabel[role="header"],
QLabel[role="section_header"],
QLabel[role="section_header_center"] {
    color: #f5f5f5;
    font-weight: 700;
}

QLabel#signatureImagePreview {
    background-color: #ffffff;
    color: #66727a;
    border: 1px dashed #606770;
    border-radius: 6px;
}

QLabel#typedSignatureFontPreview {
    background-color: #ffffff;
}

QFrame[role="card"],
QWidget[role="card"],
QFrame#sectionCard,
QWidget#sectionCard {
    background-color: #303030;
    border: 2px solid #454545;
    border-radius: 8px;
}

QTreeWidget#sidebarTree {
    border-color: #454545;
}

QFrame[role="card"]:hover,
QWidget[role="card"]:hover,
QFrame#sectionCard:hover,
QWidget#sectionCard:hover {
    border-color: #0a84ff;
}

QWidget#analyticsCriterionLegend {
    background-color: #303030;
}

QWidget#analyticsCriterionMetrics {
    background-color: #262626;
    border-radius: 6px;
}

QFrame#noDatabaseBanner {
    background-color: #203342;
    border: 1px solid #4f7b98;
    border-radius: 0px;
}

QLabel#noDatabaseTitle {
    color: #f0f6fb;
    font-weight: 700;
}

QLabel#noDatabaseSetupDescription,
QLabel#noDatabaseNewDescription,
QLabel#noDatabaseOpenDescription {
    color: #c1d0da;
}

QFrame[role="separator"] {
    color: #4b5563;
    background-color: #4b5563;
    max-height: 1px;
    border: none;
}

QFrame#campusMapDivider {
    color: #667085;
    background-color: #667085;
    border: none;
}

QLineEdit,
QPlainTextEdit,
QTextEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox,
QDateEdit,
QTimeEdit,
QDateTimeEdit,
QWidget[role="input"] {
    background-color: #1e1e1e;
    color: #f0f0f0;
    border: 2px solid #4b5563;
    border-radius: 6px;
    padding: 5px 8px;
}

QCheckBox,
QRadioButton {
    background: transparent;
    spacing: 6px;
}

QAbstractItemView::indicator,
QCheckBox::indicator,
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    background-color: #292c30;
    border: 2px solid #7f8c8d;
}

QAbstractItemView::indicator,
QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QAbstractItemView::indicator:hover,
QCheckBox::indicator:hover,
QCheckBox::indicator:focus,
QRadioButton::indicator:hover,
QRadioButton::indicator:focus {
    border-color: #3daee9;
}

QAbstractItemView::indicator:checked,
QCheckBox::indicator:checked {
    image: url(:/assets/icons/check.png);
    background-color: #3daee9;
    border-color: #3daee9;
}

QAbstractItemView::indicator:indeterminate,
QCheckBox::indicator:indeterminate {
    background-color: #3daee9;
    border-color: #3daee9;
}

QRadioButton::indicator:checked {
    image: url(:/assets/icons/radio_checked.png);
    background-color: #292c30;
    border: 2px solid #3daee9;
}

QAbstractItemView::indicator:disabled,
QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled {
    background-color: #31363b;
    border-color: #4b5056;
}

QAbstractItemView::indicator:checked:disabled,
QCheckBox::indicator:checked:disabled {
    image: url(:/assets/icons/check.png);
    background-color: #31586b;
    border-color: #31586b;
}

QComboBox:editable,
QComboBox:!editable {
    background: #1e1e1e;
}

QComboBox QLineEdit {
    background: #1e1e1e;
    color: #f0f0f0;
    border: none;
    padding: 0;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus,
QDateEdit:focus,
QTimeEdit:focus,
QDateTimeEdit:focus {
    border-color: #3daee9;
}

QLineEdit:hover,
QPlainTextEdit:hover,
QTextEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QComboBox:hover,
QDateEdit:hover,
QTimeEdit:hover,
QDateTimeEdit:hover {
    border-color: #3daee9;
}

QLineEdit[formValidationState="error"],
QPlainTextEdit[formValidationState="error"],
QTextEdit[formValidationState="error"],
QSpinBox[formValidationState="error"],
QDoubleSpinBox[formValidationState="error"],
QComboBox[formValidationState="error"],
QDateEdit[formValidationState="error"],
QTimeEdit[formValidationState="error"],
QDateTimeEdit[formValidationState="error"],
QPushButton[formValidationState="error"],
QWidget[role="input"][formValidationState="error"] {
    border-color: #ff6b6b;
}

QLineEdit[formValidationState="warning"],
QPlainTextEdit[formValidationState="warning"],
QTextEdit[formValidationState="warning"],
QSpinBox[formValidationState="warning"],
QDoubleSpinBox[formValidationState="warning"],
QComboBox[formValidationState="warning"],
QDateEdit[formValidationState="warning"],
QTimeEdit[formValidationState="warning"],
QDateTimeEdit[formValidationState="warning"],
QPushButton[formValidationState="warning"],
QWidget[role="input"][formValidationState="warning"] {
    border-color: #f6b44d;
}

QLabel[formValidationSeverity="error"] {
    color: #ff8a8a;
    background: transparent;
}

QLabel[formValidationSeverity="warning"] {
    color: #f6c15f;
    background: transparent;
}

QCheckBox[formValidationState="error"]::indicator,
QRadioButton[formValidationState="error"]::indicator {
    border-color: #ff6b6b;
}

QCheckBox[formValidationState="warning"]::indicator,
QRadioButton[formValidationState="warning"]::indicator {
    border-color: #f6b44d;
}

QLineEdit:disabled,
QPlainTextEdit:disabled,
QTextEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QComboBox:disabled,
QDateEdit:disabled,
QTimeEdit:disabled,
QDateTimeEdit:disabled {
    background-color: #252525;
    color: #777777;
    border-color: #383838;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    background-color: #1e1e1e;
    border-left: 2px solid #4b5563;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    width: 28px;
}

QComboBox {
    padding-right: 34px;
}

QComboBox::drop-down:hover {
    background-color: #3a3a3a;
}

QComboBox::drop-down:pressed {
    background-color: #262626;
}

QComboBox::down-arrow {
    image: url(:/assets/icons/combo_arrow_dark.svg);
    width: 10px;
    height: 6px;
}

QComboBox::drop-down:disabled {
    background-color: #252525;
    border-left-color: #383838;
}

QSpinBox,
QTimeEdit {
    padding-right: 30px;
}

QSpinBox::up-button,
QSpinBox::down-button,
QTimeEdit::up-button,
QTimeEdit::down-button {
    subcontrol-origin: border;
    width: 24px;
    background-color: #303030;
    border-left: 1px solid #4b5563;
}

QSpinBox::up-button,
QTimeEdit::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 6px;
}

QSpinBox::down-button,
QTimeEdit::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 6px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QTimeEdit::up-button:hover,
QTimeEdit::down-button:hover {
    background-color: #3a3a3a;
}

QSpinBox::up-arrow,
QTimeEdit::up-arrow {
    image: url(:/assets/icons/spin_up_dark.svg);
    width: 10px;
    height: 6px;
}

QSpinBox::down-arrow,
QTimeEdit::down-arrow {
    image: url(:/assets/icons/combo_arrow_dark.svg);
    width: 10px;
    height: 6px;
}

QComboBox QAbstractItemView {
    background-color: #1e1e1e;
    color: #f0f0f0;
    border: 2px solid #4b5563;
    selection-background-color: #0a84ff;
    selection-color: #ffffff;
}

QPushButton {
    background-color: #292c30;
    color: #fcfcfc;
    border: 2px solid #4b5056;
    border-radius: 6px;
    padding: 6px 12px;
    min-height: 24px;
}

QWidget#onScreenKeyboard QPushButton {
    text-align: center;
}

QPushButton:hover {
    background-color: #31363b;
    border-color: #3daee9;
}

QPushButton:pressed {
    background-color: #3daee9;
    color: #ffffff;
    border-color: #3daee9;
}

QPushButton:checked {
    background-color: #3daee9;
    color: #ffffff;
    border-color: #3daee9;
}

QPushButton:disabled {
    background-color: #2f2f2f;
    color: #777777;
    border-color: #3d3d3d;
}

QPushButton[role="button_footer"] {
    background-color: #292c30;
    border: 2px solid #4b5056;
    border-radius: 6px;
    padding: 6px 12px;
    min-height: 28px;
}

QPushButton[role="button_footer"]:hover {
    background-color: #31363b;
    border-color: #3daee9;
}

QPushButton[role="button_footer"]:pressed,
QPushButton[role="button_footer"]:checked {
    background-color: #3daee9;
    color: #ffffff;
    border-color: #3daee9;
}

QPushButton[role="button_footer"]:disabled {
    background-color: #2f2f2f;
    color: #777777;
    border-color: #3d3d3d;
}

QPushButton[role="icon_button"] {
    background-color: #292c30;
    border: 2px solid #4b5056;
    border-radius: 6px;
    padding: 0;
    min-height: 24px;
    min-width: 28px;
}

QPushButton[role="icon_button"]:hover {
    background-color: #31363b;
    border-color: #3daee9;
}

QPushButton[role="icon_button"]:pressed,
QPushButton[role="icon_button"]:checked {
    background-color: #3daee9;
    color: #ffffff;
    border-color: #3daee9;
}

QPushButton[role="icon_button"]:disabled {
    background-color: #2f2f2f;
    color: #777777;
    border-color: #3d3d3d;
}

QMenuBar {
    background-color: #2b2b2b;
    color: #f0f0f0;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 8px;
}

QMenuBar::item:selected {
    background-color: #3a3a3a;
}

QMenuBar::item:disabled {
    color: #777777;
}

QMenu {
    background-color: #252525;
    color: #f0f0f0;
    border: 1px solid #444444;
}

QMenu::separator {
    height: 1px;
    min-height: 1px;
    max-height: 1px;
    background-color: #686868;
    border: none;
    margin: 4px 8px;
}

QMenu::item {
    padding: 5px 24px;
}

QMenu::item:selected {
    background-color: #0a84ff;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #777777;
}

QTabWidget::pane {
    background-color: #2b2b2b;
    border: 1px solid #454545;
    top: -1px;
}

QTabBar::tab {
    background-color: #303030;
    color: #f0f0f0;
    border: 1px solid #454545;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    padding: 6px 14px;
    margin-right: 3px;
}

QTabBar::tab:hover {
    background-color: #3b3f43;
    border-color: #75c8f2;
}

QTabBar::tab:selected {
    background-color: #0a84ff;
    color: #ffffff;
    border-color: #75c8f2;
    font-weight: 600;
}

NavigationTabWidget,
NavigationTabStrip,
NavigationTabStrip QWidget#navigationTabContent,
NavigationTabStrip QScrollArea#navigationTabViewport,
NavigationTabStrip QScrollArea#navigationTabViewport QWidget#qt_scrollarea_viewport {
    border: 0;
    background: transparent;
}

NavigationPillButton {
    qproperty-navigationTabFillColor: #303030;
    qproperty-navigationTabBorderColor: #454545;
    qproperty-navigationTabHoverColor: #31363b;
    qproperty-navigationTabSelectedColor: #3daee9;
    qproperty-navigationTabTextColor: #f0f0f0;
}

NavigationTabStrip QToolButton#NavigationTabScrollLeftButton,
NavigationTabStrip QToolButton#NavigationTabScrollRightButton {
    background-color: #3b3f43;
    color: #ffffff;
    border: 1px solid #737a80;
    border-radius: 6px;
}

NavigationTabStrip QToolButton#NavigationTabScrollLeftButton:hover,
NavigationTabStrip QToolButton#NavigationTabScrollRightButton:hover {
    background-color: #4b535a;
    border-color: #3daee9;
}

NavigationTabStrip QToolButton#NavigationTabScrollLeftButton:pressed,
NavigationTabStrip QToolButton#NavigationTabScrollRightButton:pressed {
    background-color: #202428;
    border-color: #75c8f2;
}

NavigationTabStrip QToolButton#NavigationTabScrollLeftButton:disabled,
NavigationTabStrip QToolButton#NavigationTabScrollRightButton:disabled {
    background-color: #292c2f;
    color: #8f969c;
    border-color: #4b5055;
}

NavigationSettingsButton {
    qproperty-navigationSettingsHoverColor: #31363b;
    qproperty-navigationSettingsPressedColor: #202428;
    qproperty-navigationSettingsTextColor: #f0f0f0;
    qproperty-navigationSettingsFocusColor: #75c8f2;
}

QTableView,
QTableWidget,
QTableView[role="roster_table"],
QTableWidget[role="schedule_table"] {
    background-color: #1e1e1e;
    alternate-background-color: #2a2a2a;
    color: #f0f0f0;
    gridline-color: #3d3d3d;
    border: 1px solid #454545;
    selection-background-color: #0a84ff;
    selection-color: #ffffff;
}

QTableView::item,
QTableWidget::item {
    padding: 4px;
    border: none;
}

QTableWidget[role="schedule_table"] {
    border: none;
    gridline-color: transparent;
}

QTableWidget[role="schedule_table"]::item {
    border: none;
}

QTableWidget[role="schedule_table"] QHeaderView::section,
QTableWidget[role="schedule_table"] QHeaderView::section:hover,
QTableWidget[role="schedule_table"] QHeaderView::section:pressed {
    background-color: #303030;
    color: #c8c8c8;
    border: none;
    border-right: 1px solid #454545;
    border-bottom: 1px solid #454545;
}

QHeaderView {
    background-color: #2b2b2b;
    color: #c8c8c8;
}

QHeaderView::section {
    background-color: #303030;
    color: #c8c8c8;
    border: none;
    border-right: 1px solid #454545;
    border-bottom: 1px solid #454545;
    padding: 4px;
}

QHeaderView::section:hover {
    background-color: #383838;
}

QTableCornerButton::section {
    background-color: #303030;
    border: none;
}

QScrollArea {
    border: none;
    background: transparent;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    border: none;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #555555;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #777777;
}

QScrollBar:horizontal {
    background: transparent;
    border: none;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #555555;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #777777;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: none;
    width: 0;
    height: 0;
}

QLabel[role="schedule_cell"],
QLabel[role="schedule_multi"] {
    border-radius: 6px;
    padding: 4px;
}

QLabel[role="schedule_empty"] {
    border-radius: 6px;
    padding: 6px;
}

QSplitter::handle {
    background: transparent;
}

QToolTip {
    background-color: #2f2f2f;
    color: #f0f0f0;
    border: 1px solid #555555;
    padding: 4px;
}
