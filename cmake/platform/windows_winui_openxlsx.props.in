<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Generated by CMake from the repository-local OpenXLSX build.  The
       project imports this sheet only for the WinUI native application. -->
  <PropertyGroup>
    <ClassMngrOpenXLSXLibraryDirectory>@CLASSMNGR_OPENXLSX_OUTPUT_DIRECTORY@\$(Configuration)</ClassMngrOpenXLSXLibraryDirectory>
    <ClassMngrOpenXLSXDebugPostfix Condition="'$(Configuration)'=='Debug'">d</ClassMngrOpenXLSXDebugPostfix>
    <ClassMngrOpenXLSXDebugPostfix Condition="'$(Configuration)'!='Debug'"></ClassMngrOpenXLSXDebugPostfix>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>@CLASSMNGR_OPENXLSX_SOURCE_DIRECTORY@;@CLASSMNGR_OPENXLSX_SOURCE_DIRECTORY@/OpenXLSX/headers;@CLASSMNGR_OPENXLSX_GENERATED_INCLUDE_DIRECTORY@;@CLASSMNGR_OPENXLSX_PUGIXML_INCLUDE_DIRECTORY@;@CLASSMNGR_OPENXLSX_MINIZ_INCLUDE_DIRECTORY@;@CLASSMNGR_OPENXLSX_NOWIDE_INCLUDE_DIRECTORY@;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>ENABLE_NOWIDE;OPENXLSX_STATIC_DEFINE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(ClassMngrOpenXLSXLibraryDirectory);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>$(ClassMngrOpenXLSXLibraryDirectory)\OpenXLSX$(ClassMngrOpenXLSXDebugPostfix).lib;$(ClassMngrOpenXLSXLibraryDirectory)\pugixml.lib;$(ClassMngrOpenXLSXLibraryDirectory)\miniz.lib;$(ClassMngrOpenXLSXLibraryDirectory)\nowide.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
