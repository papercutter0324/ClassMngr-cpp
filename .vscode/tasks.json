{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "${command:cmake.activeConfigurePresetName}"
      ],
      "problemMatcher": []
    },
    {
      "label": "CMake: build",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "${command:cmake.activeBuildPresetName}"
      ],
      "group": "build",
      "problemMatcher": "$gcc"
    }
  ]
}