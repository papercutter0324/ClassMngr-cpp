{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "${command:cmake.activeConfigurePresetName}"
      ],
      "problemMatcher": []
    },
    {
      "label": "CMake: build",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "${command:cmake.activeBuildPresetName}"
      ],
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "CMake: configure release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "windows-x64-release"
      ],
      "linux": {
        "args": [
          "--preset",
          "linux-gcc-release"
        ]
      },
      "osx": {
        "args": [
          "--preset",
          "macos-clang-release"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "CMake: build release",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/build_release_windows.ps1"
      ],
      "linux": {
        "command": "cmake",
        "args": [
          "--workflow",
          "--preset",
          "linux-gcc-release-artifacts"
        ]
      },
      "osx": {
        "command": "cmake",
        "args": [
          "--workflow",
          "--preset",
          "macos-clang-universal-release-artifacts"
        ]
      },
      "group": "build",
      "problemMatcher": [
        "$gcc",
        "$msCompile"
      ]
    }
  ]
}
