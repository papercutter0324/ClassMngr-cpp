<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="Phase3WindowBackgroundColor">#FFF7F9FC</Color>
            <Color x:Key="Phase3SurfaceColor">#FFFFFFFF</Color>
            <Color x:Key="Phase3TextColor">#FF1A1A1A</Color>
            <Color x:Key="Phase3MutedTextColor">#FF5F6368</Color>
            <Color x:Key="Phase3AccentColor">#FF005FB8</Color>
            <Color x:Key="Phase3OnAccentColor">#FFFFFFFF</Color>
            <Color x:Key="Phase3ControlFillColor">#FFFFFFFF</Color>
            <Color x:Key="Phase3ControlStrokeColor">#FF747474</Color>
            <Color x:Key="Phase3ErrorColor">#FFC42B1C</Color>
            <Color x:Key="Phase3FocusColor">#FF005FB8</Color>

            <SolidColorBrush x:Key="Phase3WindowBackgroundBrush" Color="{StaticResource Phase3WindowBackgroundColor}" />
            <SolidColorBrush x:Key="Phase3SurfaceBrush" Color="{StaticResource Phase3SurfaceColor}" />
            <SolidColorBrush x:Key="Phase3TextBrush" Color="{StaticResource Phase3TextColor}" />
            <SolidColorBrush x:Key="Phase3MutedTextBrush" Color="{StaticResource Phase3MutedTextColor}" />
            <SolidColorBrush x:Key="Phase3AccentBrush" Color="{StaticResource Phase3AccentColor}" />
            <SolidColorBrush x:Key="Phase3OnAccentBrush" Color="{StaticResource Phase3OnAccentColor}" />
            <SolidColorBrush x:Key="Phase3ControlFillBrush" Color="{StaticResource Phase3ControlFillColor}" />
            <SolidColorBrush x:Key="Phase3ControlStrokeBrush" Color="{StaticResource Phase3ControlStrokeColor}" />
            <SolidColorBrush x:Key="Phase3ErrorBrush" Color="{StaticResource Phase3ErrorColor}" />
            <SolidColorBrush x:Key="Phase3FocusBrush" Color="{StaticResource Phase3FocusColor}" />

            <StaticResource x:Key="Phase1SurfaceBrush" ResourceKey="Phase3WindowBackgroundBrush" />
            <StaticResource x:Key="Phase1TextBrush" ResourceKey="Phase3TextBrush" />
            <StaticResource x:Key="Phase1AccentBrush" ResourceKey="Phase3AccentBrush" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="Phase3WindowBackgroundColor">#FF202124</Color>
            <Color x:Key="Phase3SurfaceColor">#FF2B2C2F</Color>
            <Color x:Key="Phase3TextColor">#FFF1F1F1</Color>
            <Color x:Key="Phase3MutedTextColor">#FFB8B9BA</Color>
            <Color x:Key="Phase3AccentColor">#FF8AB4F8</Color>
            <Color x:Key="Phase3OnAccentColor">#FF101114</Color>
            <Color x:Key="Phase3ControlFillColor">#FF333438</Color>
            <Color x:Key="Phase3ControlStrokeColor">#FF9A9B9D</Color>
            <Color x:Key="Phase3ErrorColor">#FFFFB4AB</Color>
            <Color x:Key="Phase3FocusColor">#FF8AB4F8</Color>

            <SolidColorBrush x:Key="Phase3WindowBackgroundBrush" Color="{StaticResource Phase3WindowBackgroundColor}" />
            <SolidColorBrush x:Key="Phase3SurfaceBrush" Color="{StaticResource Phase3SurfaceColor}" />
            <SolidColorBrush x:Key="Phase3TextBrush" Color="{StaticResource Phase3TextColor}" />
            <SolidColorBrush x:Key="Phase3MutedTextBrush" Color="{StaticResource Phase3MutedTextColor}" />
            <SolidColorBrush x:Key="Phase3AccentBrush" Color="{StaticResource Phase3AccentColor}" />
            <SolidColorBrush x:Key="Phase3OnAccentBrush" Color="{StaticResource Phase3OnAccentColor}" />
            <SolidColorBrush x:Key="Phase3ControlFillBrush" Color="{StaticResource Phase3ControlFillColor}" />
            <SolidColorBrush x:Key="Phase3ControlStrokeBrush" Color="{StaticResource Phase3ControlStrokeColor}" />
            <SolidColorBrush x:Key="Phase3ErrorBrush" Color="{StaticResource Phase3ErrorColor}" />
            <SolidColorBrush x:Key="Phase3FocusBrush" Color="{StaticResource Phase3FocusColor}" />

            <StaticResource x:Key="Phase1SurfaceBrush" ResourceKey="Phase3WindowBackgroundBrush" />
            <StaticResource x:Key="Phase1TextBrush" ResourceKey="Phase3TextBrush" />
            <StaticResource x:Key="Phase1AccentBrush" ResourceKey="Phase3AccentBrush" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="Phase3WindowBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="Phase3SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="Phase3TextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Phase3MutedTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="Phase3AccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="Phase3OnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="Phase3ControlFillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="Phase3ControlStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Phase3ErrorBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="Phase3FocusBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <StaticResource x:Key="Phase1SurfaceBrush" ResourceKey="Phase3WindowBackgroundBrush" />
            <StaticResource x:Key="Phase1TextBrush" ResourceKey="Phase3TextBrush" />
            <StaticResource x:Key="Phase1AccentBrush" ResourceKey="Phase3AccentBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
