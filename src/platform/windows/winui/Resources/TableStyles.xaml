<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Phase 6 table contract: these shared tokens are derived from the Qt
        light.qss/dark.qss table palette. Feature slices should compose these
        primitives with ListView or ItemsRepeater rather than introduce a
        monolithic table control.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="Phase6TableBackgroundColor">#FFF5F3EE</Color>
            <Color x:Key="Phase6TableAlternateRowColor">#FFE5E4DE</Color>
            <Color x:Key="Phase6TableTextColor">#FF27313A</Color>
            <Color x:Key="Phase6TableGridlineColor">#FFD2D0C9</Color>
            <Color x:Key="Phase6TableOuterBorderColor">#FFC5C7C3</Color>
            <Color x:Key="Phase6TableSelectionBackgroundColor">#FFCBDBE7</Color>
            <Color x:Key="Phase6TableSelectionTextColor">#FF1F2D38</Color>
            <Color x:Key="Phase6TableHeaderFillColor">#FFDEDED8</Color>
            <Color x:Key="Phase6TableHeaderTextColor">#FF546169</Color>
            <Color x:Key="Phase6TableHeaderBorderColor">#FFC5C7C3</Color>
            <Color x:Key="Phase6TableFocusColor">#FF3DAEE9</Color>
            <Color x:Key="Phase6TableHoverColor">#FFE9F0F5</Color>
            <Color x:Key="Phase6TableDirtyColor">#FFF3C969</Color>
            <Color x:Key="Phase6TableValidationColor">#FFE6A700</Color>
            <Color x:Key="Phase6TableWarningColor">#FFB86B00</Color>
            <Color x:Key="Phase6TableErrorColor">#FFC42B1C</Color>

            <SolidColorBrush x:Key="Phase6TableBackgroundBrush" Color="{StaticResource Phase6TableBackgroundColor}" />
            <SolidColorBrush x:Key="Phase6TableAlternateRowBrush" Color="{StaticResource Phase6TableAlternateRowColor}" />
            <SolidColorBrush x:Key="Phase6TableTextBrush" Color="{StaticResource Phase6TableTextColor}" />
            <SolidColorBrush x:Key="Phase6TableGridlineBrush" Color="{StaticResource Phase6TableGridlineColor}" />
            <SolidColorBrush x:Key="Phase6TableOuterBorderBrush" Color="{StaticResource Phase6TableOuterBorderColor}" />
            <SolidColorBrush x:Key="Phase6TableSelectionBackgroundBrush" Color="{StaticResource Phase6TableSelectionBackgroundColor}" />
            <SolidColorBrush x:Key="Phase6TableSelectionTextBrush" Color="{StaticResource Phase6TableSelectionTextColor}" />
            <SolidColorBrush x:Key="Phase6TableHeaderFillBrush" Color="{StaticResource Phase6TableHeaderFillColor}" />
            <SolidColorBrush x:Key="Phase6TableHeaderTextBrush" Color="{StaticResource Phase6TableHeaderTextColor}" />
            <SolidColorBrush x:Key="Phase6TableHeaderBorderBrush" Color="{StaticResource Phase6TableHeaderBorderColor}" />
            <SolidColorBrush x:Key="Phase6TableFocusBrush" Color="{StaticResource Phase6TableFocusColor}" />
            <SolidColorBrush x:Key="Phase6TableHoverBrush" Color="{StaticResource Phase6TableHoverColor}" />
            <SolidColorBrush x:Key="Phase6TableDirtyBrush" Color="{StaticResource Phase6TableDirtyColor}" />
            <SolidColorBrush x:Key="Phase6TableValidationBrush" Color="{StaticResource Phase6TableValidationColor}" />
            <SolidColorBrush x:Key="Phase6TableWarningBrush" Color="{StaticResource Phase6TableWarningColor}" />
            <SolidColorBrush x:Key="Phase6TableErrorBrush" Color="{StaticResource Phase6TableErrorColor}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="Phase6TableBackgroundColor">#FF1E1E1E</Color>
            <Color x:Key="Phase6TableAlternateRowColor">#FF2A2A2A</Color>
            <Color x:Key="Phase6TableTextColor">#FFF0F0F0</Color>
            <Color x:Key="Phase6TableGridlineColor">#FF3D3D3D</Color>
            <Color x:Key="Phase6TableOuterBorderColor">#FF454545</Color>
            <Color x:Key="Phase6TableSelectionBackgroundColor">#FF0A84FF</Color>
            <Color x:Key="Phase6TableSelectionTextColor">#FFFFFFFF</Color>
            <Color x:Key="Phase6TableHeaderFillColor">#FF303030</Color>
            <Color x:Key="Phase6TableHeaderTextColor">#FFC8C8C8</Color>
            <Color x:Key="Phase6TableHeaderBorderColor">#FF454545</Color>
            <Color x:Key="Phase6TableFocusColor">#FF3DAEE9</Color>
            <Color x:Key="Phase6TableHoverColor">#FF353F48</Color>
            <Color x:Key="Phase6TableDirtyColor">#FFE0B44C</Color>
            <Color x:Key="Phase6TableValidationColor">#FFF0A30A</Color>
            <Color x:Key="Phase6TableWarningColor">#FFFFB74D</Color>
            <Color x:Key="Phase6TableErrorColor">#FFFFB4AB</Color>

            <SolidColorBrush x:Key="Phase6TableBackgroundBrush" Color="{StaticResource Phase6TableBackgroundColor}" />
            <SolidColorBrush x:Key="Phase6TableAlternateRowBrush" Color="{StaticResource Phase6TableAlternateRowColor}" />
            <SolidColorBrush x:Key="Phase6TableTextBrush" Color="{StaticResource Phase6TableTextColor}" />
            <SolidColorBrush x:Key="Phase6TableGridlineBrush" Color="{StaticResource Phase6TableGridlineColor}" />
            <SolidColorBrush x:Key="Phase6TableOuterBorderBrush" Color="{StaticResource Phase6TableOuterBorderColor}" />
            <SolidColorBrush x:Key="Phase6TableSelectionBackgroundBrush" Color="{StaticResource Phase6TableSelectionBackgroundColor}" />
            <SolidColorBrush x:Key="Phase6TableSelectionTextBrush" Color="{StaticResource Phase6TableSelectionTextColor}" />
            <SolidColorBrush x:Key="Phase6TableHeaderFillBrush" Color="{StaticResource Phase6TableHeaderFillColor}" />
            <SolidColorBrush x:Key="Phase6TableHeaderTextBrush" Color="{StaticResource Phase6TableHeaderTextColor}" />
            <SolidColorBrush x:Key="Phase6TableHeaderBorderBrush" Color="{StaticResource Phase6TableHeaderBorderColor}" />
            <SolidColorBrush x:Key="Phase6TableFocusBrush" Color="{StaticResource Phase6TableFocusColor}" />
            <SolidColorBrush x:Key="Phase6TableHoverBrush" Color="{StaticResource Phase6TableHoverColor}" />
            <SolidColorBrush x:Key="Phase6TableDirtyBrush" Color="{StaticResource Phase6TableDirtyColor}" />
            <SolidColorBrush x:Key="Phase6TableValidationBrush" Color="{StaticResource Phase6TableValidationColor}" />
            <SolidColorBrush x:Key="Phase6TableWarningBrush" Color="{StaticResource Phase6TableWarningColor}" />
            <SolidColorBrush x:Key="Phase6TableErrorBrush" Color="{StaticResource Phase6TableErrorColor}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="Phase6TableBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="Phase6TableAlternateRowBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="Phase6TableTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Phase6TableGridlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Phase6TableOuterBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Phase6TableSelectionBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="Phase6TableSelectionTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="Phase6TableHeaderFillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="Phase6TableHeaderTextBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="Phase6TableHeaderBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Phase6TableFocusBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="Phase6TableHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="Phase6TableDirtyBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="Phase6TableValidationBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="Phase6TableWarningBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="Phase6TableErrorBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Shared Qt item/header padding and neutral table geometry. -->
    <Thickness x:Key="Phase6TableItemPadding">4</Thickness>
    <Thickness x:Key="Phase6TableBorderThickness">1</Thickness>
    <x:Double x:Key="Phase6TableHeaderFontSize">12</x:Double>
    <FontWeight x:Key="Phase6TableHeaderFontWeight">SemiBold</FontWeight>

    <!-- Feature metrics retain the Qt family-specific geometry. -->
    <x:Double x:Key="Phase6RosterRowHeight">50</x:Double>
    <x:Double x:Key="Phase6RosterGroupHeaderHeight">40</x:Double>
    <x:Double x:Key="Phase6RosterColumnHeaderHeight">30</x:Double>
    <x:Double x:Key="Phase6RosterHeaderHeight">70</x:Double>
    <x:Double x:Key="Phase6RosterEnglishColumnWidth">170</x:Double>
    <x:Double x:Key="Phase6RosterKoreanColumnWidth">120</x:Double>
    <x:Double x:Key="Phase6RosterEvaluationColumnWidth">130</x:Double>
    <x:Double x:Key="Phase6RosterOtherColumnWidth">100</x:Double>
    <x:Double x:Key="Phase6RosterStudentInformationMinWidth">220</x:Double>
    <x:Double x:Key="Phase6RosterGroupHeaderFontSize">11</x:Double>
    <x:Double x:Key="Phase6RosterColumnHeaderFontSize">10</x:Double>

    <x:Double x:Key="Phase6SpeakingHeaderHeight">42</x:Double>
    <x:Double x:Key="Phase6SpeakingRowHeight">50</x:Double>
    <x:Double x:Key="Phase6SpeakingIndexColumnWidth">40</x:Double>
    <x:Double x:Key="Phase6SpeakingEnglishColumnWidth">180</x:Double>
    <x:Double x:Key="Phase6SpeakingKoreanColumnWidth">180</x:Double>
    <x:Double x:Key="Phase6SpeakingScoreColumnWidth">150</x:Double>
    <x:Double x:Key="Phase6SpeakingCommentsColumnWidth">500</x:Double>
    <x:Double x:Key="Phase6SpeakingNotesColumnWidth">300</x:Double>

    <x:Double x:Key="Phase6ScheduleNormalTimeColumnWidth">90</x:Double>
    <x:Double x:Key="Phase6ScheduleNormalHeaderHeight">42</x:Double>
    <x:Double x:Key="Phase6ScheduleNormalRowHeight">48</x:Double>
    <x:Double x:Key="Phase6ScheduleCompactTimeColumnWidth">84</x:Double>
    <x:Double x:Key="Phase6ScheduleCompactHeaderHeight">36</x:Double>
    <x:Double x:Key="Phase6ScheduleCompactRowHeight">40</x:Double>

    <x:Double x:Key="Phase6StaffRowMinHeight">42</x:Double>
    <x:Double x:Key="Phase6StaffHeaderMinHeight">38</x:Double>
    <!-- Qt computes header height from font metrics plus 16 px total vertical padding. -->
    <Thickness x:Key="Phase6StaffHeaderPadding">8</Thickness>

    <x:Double x:Key="Phase6AnalyticsHeaderHeight">42</x:Double>
    <x:Double x:Key="Phase6AnalyticsBadgeWidth">38</x:Double>
    <x:Double x:Key="Phase6AnalyticsBadgeHeight">26</x:Double>
    <x:Double x:Key="Phase6AnalyticsIndexColumnWidth">40</x:Double>
    <x:Double x:Key="Phase6AnalyticsEnglishColumnWidth">160</x:Double>
    <x:Double x:Key="Phase6AnalyticsKoreanColumnWidth">140</x:Double>
    <x:Double x:Key="Phase6AnalyticsAverageColumnWidth">90</x:Double>

    <!-- Lightweight primitives for feature slices. Selection and state
         overlays remain explicit so recycled ListView/ItemsRepeater elements
         do not inherit an accidental feature-specific row treatment. -->
    <Style x:Key="Phase6TableBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Phase6TableBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Phase6TableOuterBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource Phase6TableBorderThickness}" />
    </Style>

    <Style x:Key="Phase6TableCellBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Phase6TableBackgroundBrush}" />
        <Setter Property="Padding" Value="{StaticResource Phase6TableItemPadding}" />
    </Style>

    <Style x:Key="Phase6TableHeaderBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Phase6TableHeaderFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Phase6TableHeaderBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="{StaticResource Phase6TableItemPadding}" />
    </Style>

    <Style x:Key="Phase6TableHeaderTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Phase3TextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource Phase6TableHeaderFontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource Phase6TableHeaderFontWeight}" />
        <Setter Property="Foreground" Value="{ThemeResource Phase6TableHeaderTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Phase6TableCellTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Phase3TextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource Phase3BodyFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource Phase6TableTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Phase6TableSelectedCellTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource Phase6TableCellTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource Phase6TableSelectionTextBrush}" />
    </Style>

    <Style x:Key="Phase6TableListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="Foreground" Value="{ThemeResource Phase6TableTextBrush}" />
        <Setter Property="Padding" Value="{StaticResource Phase6TableItemPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="Phase6TableSelectedCellBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Phase6TableSelectionBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Phase6TableFocusBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource Phase6TableItemPadding}" />
    </Style>

    <Style x:Key="Phase6TableHoverCellBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Phase6TableHoverBrush}" />
        <Setter Property="Padding" Value="{StaticResource Phase6TableItemPadding}" />
    </Style>

    <Style x:Key="Phase6TableDirtyCellBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Phase6TableDirtyBrush}" />
        <Setter Property="Padding" Value="{StaticResource Phase6TableItemPadding}" />
    </Style>

    <Style x:Key="Phase6TableValidationCellBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource Phase6TableValidationBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="{StaticResource Phase6TableItemPadding}" />
    </Style>

    <Style x:Key="Phase6TableWarningCellBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource Phase6TableWarningBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="{StaticResource Phase6TableItemPadding}" />
    </Style>

    <Style x:Key="Phase6TableErrorCellBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource Phase6TableErrorBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="{StaticResource Phase6TableItemPadding}" />
    </Style>

    <Style x:Key="Phase6RosterRowBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Phase6TableBackgroundBrush}" />
        <Setter Property="Height" Value="{StaticResource Phase6RosterRowHeight}" />
        <Setter Property="Padding" Value="{StaticResource Phase6TableItemPadding}" />
    </Style>

    <Style x:Key="Phase6RosterGroupHeaderBorderStyle" TargetType="Border" BasedOn="{StaticResource Phase6TableHeaderBorderStyle}">
        <Setter Property="Height" Value="{StaticResource Phase6RosterGroupHeaderHeight}" />
    </Style>

    <Style x:Key="Phase6RosterColumnHeaderBorderStyle" TargetType="Border" BasedOn="{StaticResource Phase6TableHeaderBorderStyle}">
        <Setter Property="Height" Value="{StaticResource Phase6RosterColumnHeaderHeight}" />
    </Style>

    <Style x:Key="Phase6RosterGroupHeaderTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource Phase6TableHeaderTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource Phase6RosterGroupHeaderFontSize}" />
    </Style>

    <Style x:Key="Phase6RosterColumnHeaderTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource Phase6TableHeaderTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource Phase6RosterColumnHeaderFontSize}" />
    </Style>

    <Style x:Key="Phase6SpeakingHeaderBorderStyle" TargetType="Border" BasedOn="{StaticResource Phase6TableHeaderBorderStyle}">
        <Setter Property="Height" Value="{StaticResource Phase6SpeakingHeaderHeight}" />
    </Style>

    <Style x:Key="Phase6SpeakingRowBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Phase6TableBackgroundBrush}" />
        <Setter Property="Height" Value="{StaticResource Phase6SpeakingRowHeight}" />
        <Setter Property="Padding" Value="{StaticResource Phase6TableItemPadding}" />
    </Style>

    <!-- Schedule deliberately has no outer border or gridline. -->
    <Style x:Key="Phase6ScheduleSurfaceBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Phase6TableBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="Phase6ScheduleNormalHeaderBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Phase6TableHeaderFillBrush}" />
        <Setter Property="Height" Value="{StaticResource Phase6ScheduleNormalHeaderHeight}" />
        <Setter Property="Padding" Value="{StaticResource Phase6TableItemPadding}" />
    </Style>

    <Style x:Key="Phase6ScheduleNormalRowBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Phase6TableBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="{StaticResource Phase6ScheduleNormalRowHeight}" />
        <Setter Property="Padding" Value="{StaticResource Phase6TableItemPadding}" />
    </Style>

    <Style x:Key="Phase6ScheduleCompactHeaderBorderStyle" TargetType="Border" BasedOn="{StaticResource Phase6ScheduleNormalHeaderBorderStyle}">
        <Setter Property="Height" Value="{StaticResource Phase6ScheduleCompactHeaderHeight}" />
    </Style>

    <Style x:Key="Phase6ScheduleCompactRowBorderStyle" TargetType="Border" BasedOn="{StaticResource Phase6ScheduleNormalRowBorderStyle}">
        <Setter Property="Height" Value="{StaticResource Phase6ScheduleCompactRowHeight}" />
    </Style>

    <Style x:Key="Phase6StaffRowBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Phase6TableBackgroundBrush}" />
        <Setter Property="MinHeight" Value="{StaticResource Phase6StaffRowMinHeight}" />
        <Setter Property="Padding" Value="{StaticResource Phase6TableItemPadding}" />
    </Style>

    <Style x:Key="Phase6StaffHeaderBorderStyle" TargetType="Border" BasedOn="{StaticResource Phase6TableHeaderBorderStyle}">
        <Setter Property="MinHeight" Value="{StaticResource Phase6StaffHeaderMinHeight}" />
        <Setter Property="Padding" Value="{StaticResource Phase6StaffHeaderPadding}" />
    </Style>

    <Style x:Key="Phase6AnalyticsHeaderBorderStyle" TargetType="Border" BasedOn="{StaticResource Phase6TableHeaderBorderStyle}">
        <Setter Property="Height" Value="{StaticResource Phase6AnalyticsHeaderHeight}" />
    </Style>

    <Style x:Key="Phase6AnalyticsBadgeBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource Phase6AnalyticsBadgeWidth}" />
        <Setter Property="Height" Value="{StaticResource Phase6AnalyticsBadgeHeight}" />
        <Setter Property="Background" Value="{ThemeResource Phase6TableHeaderFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Phase6TableGridlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
