<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="Phase3TitleBarTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Phase3TextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource Phase3TitleFontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource Phase3TitleFontWeight}" />
        <Setter Property="Foreground" Value="{ThemeResource Phase3TextBrush}" />
        <Setter Property="IsTextScaleFactorEnabled" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Phase3PageTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Phase3TextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource Phase3PageTitleFontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource Phase3PageTitleFontWeight}" />
        <Setter Property="Foreground" Value="{ThemeResource Phase3TextBrush}" />
        <Setter Property="IsTextScaleFactorEnabled" Value="True" />
    </Style>

    <Style x:Key="Phase3BodyTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Phase3TextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource Phase3BodyFontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource Phase3BodyFontWeight}" />
        <Setter Property="Foreground" Value="{ThemeResource Phase3TextBrush}" />
        <Setter Property="IsTextScaleFactorEnabled" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Phase3PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource Phase3AccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource Phase3OnAccentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Phase3TextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource Phase3BodyFontSize}" />
        <Setter Property="Padding" Value="{StaticResource Phase3ButtonPadding}" />
        <Setter Property="MinHeight" Value="{StaticResource Phase3ControlMinHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource Phase3ControlCornerRadius}" />
    </Style>

    <Style x:Key="Phase3SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource Phase3ControlFillBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource Phase3TextBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Phase3ControlStrokeBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Phase3TextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource Phase3BodyFontSize}" />
        <Setter Property="Padding" Value="{StaticResource Phase3ButtonPadding}" />
        <Setter Property="MinHeight" Value="{StaticResource Phase3ControlMinHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource Phase3ControlCornerRadius}" />
    </Style>

    <Style x:Key="Phase3NavigationViewStyle" TargetType="NavigationView">
        <Setter Property="Background" Value="{ThemeResource Phase3SurfaceBrush}" />
        <Setter Property="Padding" Value="{StaticResource Phase3NavigationPadding}" />
    </Style>
</ResourceDictionary>
