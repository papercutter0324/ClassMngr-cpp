<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="Phase3TitleBarTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Phase3TextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource Phase3TitleFontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource Phase3TitleFontWeight}" />
        <Setter Property="Foreground" Value="{ThemeResource Phase3TextBrush}" />
        <Setter Property="IsTextScaleFactorEnabled" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Phase3PageTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Phase3TextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource Phase3PageTitleFontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource Phase3PageTitleFontWeight}" />
        <Setter Property="Foreground" Value="{ThemeResource Phase3TextBrush}" />
        <Setter Property="IsTextScaleFactorEnabled" Value="True" />
    </Style>

    <Style x:Key="Phase3BodyTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Phase3TextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource Phase3BodyFontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource Phase3BodyFontWeight}" />
        <Setter Property="Foreground" Value="{ThemeResource Phase3TextBrush}" />
        <Setter Property="IsTextScaleFactorEnabled" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Phase3PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource Phase3AccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource Phase3OnAccentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Phase3TextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource Phase3BodyFontSize}" />
        <Setter Property="Padding" Value="{StaticResource Phase3ButtonPadding}" />
        <Setter Property="MinHeight" Value="{StaticResource Phase3ControlMinHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource Phase3ControlCornerRadius}" />
    </Style>

    <Style x:Key="Phase3SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource Phase3ControlFillBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource Phase3TextBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Phase3ControlStrokeBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Phase3TextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource Phase3BodyFontSize}" />
        <Setter Property="Padding" Value="{StaticResource Phase3ButtonPadding}" />
        <Setter Property="MinHeight" Value="{StaticResource Phase3ControlMinHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource Phase3ControlCornerRadius}" />
    </Style>

    <Style x:Key="Phase3NavigationViewStyle" TargetType="NavigationView">
        <Setter Property="Background" Value="{ThemeResource Phase3SurfaceBrush}" />
        <Setter Property="Padding" Value="{StaticResource Phase3NavigationPadding}" />
    </Style>

    <!-- Phase 4 product-scoped patterns. ThemeResource references keep these
         components usable in light, dark, and high-contrast themes. -->
    <Style x:Key="Phase4FormFieldStackPanelStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="{StaticResource Phase3Spacing4}" />
    </Style>

    <Style x:Key="Phase4FormFieldTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource Phase3TextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource Phase3BodyFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource Phase3TextBrush}" />
        <Setter Property="MinHeight" Value="{StaticResource Phase3ControlMinHeight}" />
    </Style>

    <Style x:Key="Phase4ValidationTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Phase3TextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource Phase3CaptionFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource Phase3ErrorBrush}" />
        <Setter Property="IsTextScaleFactorEnabled" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Phase4CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Phase3SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Phase3ControlStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Phase3ControlCornerRadius}" />
    </Style>

    <Style x:Key="Phase4CardTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Phase3TextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource Phase3TitleFontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource Phase3TitleFontWeight}" />
        <Setter Property="Foreground" Value="{ThemeResource Phase3TextBrush}" />
        <Setter Property="IsTextScaleFactorEnabled" Value="True" />
    </Style>

    <Style x:Key="Phase4CardDescriptionTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Phase3TextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource Phase3BodyFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource Phase3MutedTextBrush}" />
        <Setter Property="IsTextScaleFactorEnabled" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Phase4EmptyStateBorderStyle" TargetType="Border" BasedOn="{StaticResource Phase4CardBorderStyle}" />
    <Style x:Key="Phase4ErrorStateBorderStyle" TargetType="Border" BasedOn="{StaticResource Phase4CardBorderStyle}">
        <Setter Property="BorderBrush" Value="{ThemeResource Phase3ErrorBrush}" />
    </Style>

    <Style x:Key="Phase4StateTitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource Phase4CardTitleTextBlockStyle}" />
    <Style x:Key="Phase4ErrorStateTitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource Phase4StateTitleTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource Phase3ErrorBrush}" />
    </Style>
    <Style x:Key="Phase4StateDescriptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource Phase4CardDescriptionTextBlockStyle}" />
    <Style x:Key="Phase4StateActionButtonStyle" TargetType="Button" BasedOn="{StaticResource Phase3SecondaryButtonStyle}" />

    <Style x:Key="Phase4FilterBarStackPanelStyle" TargetType="StackPanel">
        <Setter Property="Background" Value="{ThemeResource Phase3SurfaceBrush}" />
    </Style>
    <Style x:Key="Phase4FilterTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource Phase4FormFieldTextBoxStyle}" />
    <Style x:Key="Phase4FilterComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource Phase3TextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource Phase3BodyFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource Phase3TextBrush}" />
        <Setter Property="MinHeight" Value="{StaticResource Phase3ControlMinHeight}" />
    </Style>
    <Style x:Key="Phase4FilterClearButtonStyle" TargetType="Button" BasedOn="{StaticResource Phase3SecondaryButtonStyle}" />

    <Style x:Key="Phase4StatusSurfaceBorderStyle" TargetType="Border" BasedOn="{StaticResource Phase4CardBorderStyle}" />
    <Style x:Key="Phase4StatusTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource Phase4CardDescriptionTextBlockStyle}" />
    <Style x:Key="Phase4AutosaveStateBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Phase3ControlFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Phase3ControlStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Phase3ControlCornerRadius}" />
    </Style>
    <Style x:Key="Phase4AutosaveStateTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource Phase4CardDescriptionTextBlockStyle}" />
</ResourceDictionary>
