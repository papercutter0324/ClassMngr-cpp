<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- XamlAutoFontFamily keeps the system-selected font and text scaling behavior. -->
    <FontFamily x:Key="Phase3TextFontFamily">XamlAutoFontFamily</FontFamily>
    <FontFamily x:Key="Phase3IconFontFamily">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>

    <x:Double x:Key="Phase3CaptionFontSize">12</x:Double>
    <x:Double x:Key="Phase3BodyFontSize">14</x:Double>
    <x:Double x:Key="Phase3SubtitleFontSize">20</x:Double>
    <x:Double x:Key="Phase3TitleFontSize">16</x:Double>
    <x:Double x:Key="Phase3PageTitleFontSize">28</x:Double>

    <FontWeight x:Key="Phase3BodyFontWeight">Normal</FontWeight>
    <FontWeight x:Key="Phase3TitleFontWeight">SemiBold</FontWeight>
    <FontWeight x:Key="Phase3PageTitleFontWeight">SemiBold</FontWeight>

    <!-- Named size tiers document the supported text-scale contract. Controls retain
         their default IsTextScaleFactorEnabled behavior so Windows text scaling applies. -->
    <x:Double x:Key="Phase3TextScaleDefault">1</x:Double>
    <x:Double x:Key="Phase3TextScaleLarge">1.25</x:Double>
    <x:Double x:Key="Phase3TextScaleExtraLarge">1.5</x:Double>
</ResourceDictionary>
