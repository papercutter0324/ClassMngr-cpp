<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ClassMngrWinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Phase1SurfaceBrush" Color="#FFF7F9FC" />
                    <SolidColorBrush x:Key="Phase1TextBrush" Color="#FF1A1A1A" />
                    <SolidColorBrush x:Key="Phase1AccentBrush" Color="#FF005FB8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Phase1SurfaceBrush" Color="#FF202124" />
                    <SolidColorBrush x:Key="Phase1TextBrush" Color="#FFF1F1F1" />
                    <SolidColorBrush x:Key="Phase1AccentBrush" Color="#FF8AB4F8" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
