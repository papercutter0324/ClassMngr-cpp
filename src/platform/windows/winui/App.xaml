<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ClassMngrWinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
                <ResourceDictionary Source="ms-appx:///Resources/ThemeColors.xaml" />
                <ResourceDictionary Source="ms-appx:///Resources/ThemeTypography.xaml" />
                <ResourceDictionary Source="ms-appx:///Resources/ThemeSpacing.xaml" />
                <ResourceDictionary Source="ms-appx:///Resources/ThemeIcons.xaml" />
                <ResourceDictionary Source="ms-appx:///Resources/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
