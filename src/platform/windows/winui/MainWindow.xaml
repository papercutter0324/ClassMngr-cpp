<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClassMngrWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ClassMngr">
    <Grid
        x:Name="RootGrid"
        Padding="32"
        Background="{ThemeResource Phase1SurfaceBrush}"
        RequestedTheme="Default">
        <StackPanel
            Width="640"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">
            <TextBlock
                Text="ClassMngr Windows"
                Foreground="{ThemeResource Phase1TextBrush}"
                FontSize="32"
                FontWeight="SemiBold" />
            <TextBlock
                x:Name="EngineVersionText"
                Foreground="{ThemeResource Phase1AccentBrush}"
                FontSize="16"
                AutomationProperties.Name="Engine version" />
            <TextBlock
                Text="Phase 1 representative form"
                Foreground="{ThemeResource Phase1TextBrush}"
                Opacity="0.78" />
            <TextBox
                x:Name="NameTextBox"
                Header="이름"
                PlaceholderText="한국어 입력"
                InputScope="Text"
                TabIndex="0"
                AutomationProperties.Name="Name input" />
            <Button
                x:Name="ContinueButton"
                Content="Continue"
                Click="ContinueButton_Click"
                IsDefault="True"
                TabIndex="1"
                HorizontalAlignment="Left"
                AutomationProperties.Name="Continue" />
            <TextBlock
                x:Name="StatusText"
                Text="Ready"
                Foreground="{ThemeResource Phase1TextBrush}"
                AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Grid>
</Window>
